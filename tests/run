for section in "Own skills:" "Name clashes:"; do
	if [ "$(printf '%s\n' "$out" | sed -n "/^$section\$/{n;p;}")" = "  none" ]; then ok; else
		bad "survey: nothing under $section" "$out"
	fi
done
surveyed "a policy file" "  open-pr: .agents/policy/open-pr.md exists. If"
