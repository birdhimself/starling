#!/bin/sh
# Run Starling's tests. Needs only POSIX sh and git.
#
# tests/commit-msg/NAME.msg is a commit message. Without NAME.expect it must
# pass; with NAME.expect it must fail with output containing that file's text.
# Messages are checked in a scratch repository whose .starling.conf allows the
# scopes api, deps, server and ui.
#
# TEST_SH runs the scripts under test with a given shell, e.g. TEST_SH=dash.
# Without it, they run with their own #! line.

set -u
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
check="$root/.starling/bin/check-commit-msg"
hook="$root/.starling/hooks/commit-msg"
msgs="$root/tests/commit-msg"
passed=0
failed=0

ok() { passed=$((passed + 1)); }
bad() { failed=$((failed + 1)); printf 'FAIL %s\n%s\n\n' "$1" "$2"; }
run() { if [ -f "$1" ]; then ${TEST_SH:+$TEST_SH} "$@"; else "$@"; fi; }

# Scratch repositories: $repo allows scopes, $other starts without a list.
tmp=$(mktemp -d) || exit 2
trap 'rm -rf "$tmp"' EXIT
repo=$tmp/repo
other=$tmp/other
for dir in "$repo" "$other"; do
	git init -q -b main "$dir" &&
		git -C "$dir" config user.name Test &&
		git -C "$dir" config user.email test@example.com || exit 2
done
printf '[commit]\n\tscopes = api deps server ui\n' >"$repo/.starling.conf"

# expect DIR NAME WANT_STATUS WANT_TEXT COMMAND ARGS...: run the command in DIR.
expect() {
	dir=$1 name=$2 want_status=$3 want=$4
	shift 4
	out=$(cd "$dir" && run "$@" 2>&1)
	status=$?
	if [ "$status" -eq "$want_status" ] && { [ -z "$want" ] || printf '%s\n' "$out" | grep -qF -- "$want"; }; then ok; else
		bad "$name" "expected exit $want_status and \"$want\", got exit $status:
$out"
	fi
}

# Messages, checked as the commit-msg hook checks them.
for msg in "$msgs"/*.msg; do
	name=$(basename "$msg" .msg)
	if [ -f "${msg%.msg}.expect" ]; then
		expect "$repo" "$name" 1 "$(cat "${msg%.msg}.expect")" "$check" "$msg"
	else
		expect "$repo" "$name" 0 "" "$check" "$msg"
	fi
done

# The hook passes the message file on to the checker.
expect "$repo" "hook: valid message" 0 "" "$hook" "$msgs/valid-full.msg"
expect "$repo" "hook: invalid message" 1 'type `chore` is not allowed' "$hook" "$msgs/chore.msg"

# Usage errors.
expect "$repo" "usage: no arguments" 2 "usage:" "$check"

# Every .starling/ path that Starling's instructions name exists.
missing=$(find "$root/.starling" -name '*.md' | while read -r md; do
	awk '{
		s = $0
		while (match(s, /`\.starling\/[^` "]*/)) {
			print substr(s, RSTART + 1, RLENGTH - 1)
			s = substr(s, RSTART + RLENGTH)
		}
	}' "$md" | while read -r path; do
		[ -e "$root/$path" ] || echo "${md#"$root"/} names $path"
	done
done)
if [ -z "$missing" ]; then ok; else bad "instructions: named paths exist" "$missing"; fi

# Claude Code resolves an @ import only where the path ends the line or is
# followed by a space: in "@.starling/AGENTS.md." the period becomes part of
# the path.
if grep -q ' @\.starling/AGENTS\.md$' "$root/AGENTS.md"; then ok; else
	bad "instructions: import line" "AGENTS.md needs a line ending in ' @.starling/AGENTS.md'"
fi

# Starling uses its own skills, linked as the installer links them.
for skill in "$root"/.starling/skills/*/; do
	name=$(basename "$skill")
	for dir in .claude/skills .agents/skills; do
		if [ "$(cd "$root/$dir/$name" 2>/dev/null && pwd -P)" = "$(cd "$skill" && pwd -P)" ]; then ok; else
			bad "skills: $dir/$name" "expected a link to ../../.starling/skills/$name"
		fi
	done
done

# Scripts keep data in variables and pipes. Sandboxes refuse writes to the
# system's temporary directory, and a bare mktemp ignores TMPDIR on macOS.
if found=$(grep -l mktemp "$root"/.starling/bin/* "$root"/.starling/skills/*/scripts/* 2>/dev/null); then
	bad "scripts: no temporary files" "mktemp in: $found"
else ok; fi

# Scopes come from the repository's .starling.conf.
expect "$other" "scopes: none without a list" 1 \
	'this repository defines no scopes; drop `(api)`: `feat!: drop the v1 widget endpoints`' \
	"$check" "$msgs/valid-breaking.msg"
expect "$other" "scopes: no scope without a list" 0 "" "$check" "$msgs/valid-full.msg"
printf '[commit]\n\tscopes = server\n\tscopes = ui\n' >"$other/.starling.conf"
expect "$other" "scopes: every scopes line counts" 0 "" "$check" "$msgs/valid-note-in-body.msg"
expect "$other" "scopes: listed on separate lines" 1 "this repository allows: server, ui" \
	"$check" "$msgs/valid-breaking.msg"
printf '[commit\n\tscopes = server\n' >"$other/.starling.conf"
expect "$other" "scopes: unreadable .starling.conf" 2 "cannot read" "$check" "$msgs/valid-full.msg"

# The commit-changes context script, in a clone whose branch has a pushed and
# a local commit.
context="$root/.starling/skills/commit-changes/scripts/context"
work=$tmp/work
{
	git init -q --bare "$tmp/origin.git" &&
		git init -q -b main "$work" &&
		git -C "$work" config user.name Test &&
		git -C "$work" config user.email test@example.com &&
		git -C "$work" commit -q --allow-empty -F "$msgs/valid-full.msg" &&
		git -C "$work" remote add origin "$tmp/origin.git" &&
		git -C "$work" push -q -u origin main 2>/dev/null &&
		git -C "$work" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main &&
		git -C "$work" checkout -q -b topic &&
		git -C "$work" commit -q --allow-empty -F "$msgs/valid-breaking.msg" &&
		git -C "$work" push -q -u origin topic 2>/dev/null &&
		git -C "$work" commit -q --allow-empty -F "$msgs/valid-url-line.msg" &&
		echo change >"$work/new-file" &&
		mkdir "$work/sub"
} || exit 2

expect "$work" "context: no scopes" 0 "Scopes: none, so headers take no scope" "$context"
expect "$work" "context: branch" 0 "Branch: topic, pushed to origin/topic" "$context"
expect "$work" "context: base" 0 "Base: origin/main, forked at" "$context"
expect "$work" "context: pushed commit" 0 " pushed feat(api)!: drop the v1 widget endpoints" "$context"
expect "$work" "context: local commit" 0 " local  docs: link the upstream issue" "$context"
expect "$work" "context: changes" 0 "?? new-file" "$context"
expect "$work/sub" "context: from a subdirectory" 0 "Branch: topic" "$context"
printf '[commit]\n\tscopes = api\n\tscopes = ui\n' >"$work/.starling.conf"
expect "$work" "context: scopes" 0 "Scopes: api ui" "$context"
git -C "$work" rev-parse HEAD >"$work/.git/MERGE_HEAD"
expect "$work" "context: merge in progress" 0 "In progress: a merge" "$context"
rm "$work/.git/MERGE_HEAD"
expect "$other" "context: no commits yet" 2 "cannot read .starling.conf" "$context"
rm "$other/.starling.conf"
expect "$other" "context: no commits yet" 0 "Commits: none yet" "$context"
expect "$tmp" "context: outside a repository" 2 "not inside a git work tree" "$context"

# The Claude Code hook that blocks hook bypasses. tests/deny-hook-bypass/
# NAME.cmd is a Bash command: without NAME.expect it must be allowed, with it
# blocked with that text. bash_input wraps it in Claude Code's hook input.
guard="$root/.starling/bin/deny-hook-bypass"
bash_input() {
	LC_ALL=C awk 'BEGIN { RS = "\001" } {
		s = $0; sub(/\n$/, "", s); out = ""
		for (i = 1; i <= length(s); i++) {
			c = substr(s, i, 1)
			if (c == "\\") c = "\\\\"
			else if (c == "\"") c = "\\\""
			else if (c == "\n") c = "\\n"
			else if (c == "\t") c = "\\t"
			out = out c
		}
		printf "{\"session_id\":\"test\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"%s\",\"description\":\"test\"}}", out
	}' "$1"
}
for cmd in "$root"/tests/deny-hook-bypass/*.cmd; do
	name="guard: $(basename "$cmd" .cmd)"
	out=$(bash_input "$cmd" | run "$guard" 2>&1)
	status=$?
	if [ -f "${cmd%.cmd}.expect" ]; then
		want=$(cat "${cmd%.cmd}.expect")
		if [ "$status" -eq 2 ] && printf '%s\n' "$out" | grep -qF -- "$want"; then ok; else
			bad "$name" "expected exit 2 and \"$want\", got exit $status:
$out"
		fi
	elif [ "$status" -eq 0 ] && [ -z "$out" ]; then ok; else
		bad "$name" "expected to be allowed, got exit $status:
$out"
	fi
done
out=$(printf 'not json' | run "$guard" 2>&1)
if [ $? -eq 0 ] && [ -z "$out" ]; then ok; else bad "guard: unreadable input" "expected to be allowed: $out"; fi

# Activation sets core.hooksPath, unless another tool set it.
act="$root/.starling/bin/activate-hooks"
mkdir -p "$tmp/act/.starling/hooks" && git init -q "$tmp/act" || exit 2
expect "$tmp/act" "activate: sets the hooks path" 0 "" "$act"
if [ "$(git -C "$tmp/act" config core.hooksPath)" = .starling/hooks ]; then ok; else
	bad "activate: hooks path" "core.hooksPath is '$(git -C "$tmp/act" config core.hooksPath)'"
fi
out=$(cd "$tmp/act" && run "$act" 2>&1)
if [ $? -eq 0 ] && [ -z "$out" ]; then ok; else bad "activate: quiet when active" "got: $out"; fi
git -C "$tmp/act" config core.hooksPath .husky/_
expect "$tmp/act" "activate: leaves another hooks path" 1 "core.hooksPath is
.husky/_" "$act"
if [ "$(git -C "$tmp/act" config core.hooksPath)" = .husky/_ ]; then ok; else
	bad "activate: other path unchanged" "core.hooksPath is '$(git -C "$tmp/act" config core.hooksPath)'"
fi
expect "$tmp/repo" "activate: without Starling" 2 "" "$act"

# Starling's hooks run the repository's own hooks in .githooks/.
for h in pre-commit pre-merge-commit prepare-commit-msg commit-msg post-commit \
	pre-rebase post-checkout post-merge post-rewrite pre-push; do
	if [ -x "$root/.starling/hooks/$h" ]; then ok; else bad "hooks: $h" "missing or not executable"; fi
done
fwd=$tmp/fwd
{
	git init -q "$fwd" &&
		git -C "$fwd" config user.name Test &&
		git -C "$fwd" config user.email test@example.com &&
		git -C "$fwd" config commit.gpgsign false &&
		git -C "$fwd" config core.hooksPath "$root/.starling/hooks" &&
		mkdir "$fwd/.githooks"
} || exit 2
printf '#!/bin/sh\necho "$(basename "$0") $*" >>.git/ran\n' >"$fwd/.githooks/pre-commit"
cp "$fwd/.githooks/pre-commit" "$fwd/.githooks/commit-msg"
chmod +x "$fwd/.githooks/pre-commit" "$fwd/.githooks/commit-msg"
expect "$fwd" "hooks: commit with project hooks" 0 "" git commit -q --allow-empty -F "$msgs/valid-full.msg"
if grep -q '^pre-commit' "$fwd/.git/ran" && grep -q '^commit-msg .git/COMMIT_EDITMSG' "$fwd/.git/ran"; then ok; else
	bad "hooks: project hooks ran" "$(cat "$fwd/.git/ran" 2>&1)"
fi
rm -f "$fwd/.git/ran"
expect "$fwd" "hooks: Starling's check runs first" 1 'type `chore` is not allowed' \
	git commit -q --allow-empty -F "$msgs/chore.msg"
if [ ! -s "$fwd/.git/ran" ] || ! grep -q '^commit-msg' "$fwd/.git/ran"; then ok; else
	bad "hooks: project commit-msg after a failed check" "it ran: $(cat "$fwd/.git/ran")"
fi
printf '#!/bin/sh\nexit 1\n' >"$fwd/.githooks/pre-commit"
expect "$fwd" "hooks: a failing project hook stops the commit" 1 "" \
	git commit -q --allow-empty -F "$msgs/valid-full.msg"
rm "$fwd/.githooks/pre-commit"
printf '#!/bin/sh\nexit 0\n' >"$fwd/.githooks/post-commit"
expect "$fwd" "hooks: a project hook that is not executable" 0 ".githooks/post-commit is not executable" \
	git commit -q --allow-empty -F "$msgs/valid-full.msg"

# Ranges, checked as CI checks them.
git -C "$repo" commit -q --allow-empty -F "$msgs/valid-full.msg" || exit 2
git -C "$repo" commit -q --allow-empty -F "$msgs/valid-breaking.msg" || exit 2
base=$(git -C "$repo" rev-list --max-parents=0 HEAD)

expect "$repo" "range: clean range passes" 0 "" "$check" --range "$base..HEAD"
expect "$repo" "range: unreadable range fails" 2 "cannot read the commit range" "$check" --range "nope..HEAD"
git -C "$repo" commit -q --allow-empty -F "$msgs/valid-fixup.msg"
expect "$repo" "range: fixup passes by default" 0 "" "$check" --range "$base..HEAD"
expect "$repo" "range: fixup fails with --reject-fixups" 1 "git rebase -i --autosquash" \
	"$check" --range "$base..HEAD" --reject-fixups
git -C "$repo" commit -q --allow-empty -F "$msgs/chore.msg"
expect "$repo" "range: bad message fails and names the commit" 1 "chore(deps): update vite" \
	"$check" --range "$base..HEAD"
expect "$repo" "range: failure points to the skill" 1 "commit-changes skill" "$check" --range "$base..HEAD"
git -C "$repo" reset -q --hard HEAD~2
git -C "$repo" checkout -q -b side
git -C "$repo" commit -q --allow-empty -F "$msgs/valid-url-line.msg"
git -C "$repo" checkout -q main
git -C "$repo" merge -q --no-ff --no-edit side
expect "$repo" "range: merge passes by default" 0 "" "$check" --range "$base..HEAD"
expect "$repo" "range: merge fails with --reject-merges" 1 "Merge commits are not allowed" \
	"$check" --range "$base..HEAD" --reject-merges

echo "$passed passed, $failed failed"
[ "$failed" -eq 0 ]
