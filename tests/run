		echo "# Old rules" >"$tgt/CLAUDE.md" && echo "# Docs" >"$tgt/docs/AGENTS.md" &&
		echo "#!/bin/sh" >"$tgt/.githooks/pre-commit" && echo "#!/bin/sh" >"$tgt/.husky/pre-push" &&
		echo "#!/bin/sh" >"$tgt/.git/hooks/post-merge" &&
