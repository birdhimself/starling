#!/bin/sh
# Run Starling's tests. Needs only POSIX sh and git.
#
# tests/commit-msg/NAME.msg is a commit message. Without NAME.expect it must
# pass; with NAME.expect it must fail with output containing that file's text.
# Messages are checked in a scratch repository whose .starling.conf allows the
# scopes api, deps, server and ui.
#
# TEST_SH runs the scripts under test with a given shell, e.g. TEST_SH=dash.
# Without it, they run with their own #! line.

set -u
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
check="$root/.starling/bin/check-commit-msg"
hook="$root/.starling/hooks/commit-msg"
msgs="$root/tests/commit-msg"
passed=0
failed=0

ok() { passed=$((passed + 1)); }
bad() { failed=$((failed + 1)); printf 'FAIL %s\n%s\n\n' "$1" "$2"; }
run() { if [ -f "$1" ]; then ${TEST_SH:+$TEST_SH} "$@"; else "$@"; fi; }

# Scratch repositories: $repo allows scopes, $other starts without a list.
tmp=$(mktemp -d) || exit 2
trap 'rm -rf "$tmp"' EXIT
repo=$tmp/repo
other=$tmp/other
for dir in "$repo" "$other"; do
	git init -q -b main "$dir" &&
		git -C "$dir" config user.name Test &&
		git -C "$dir" config user.email test@example.com || exit 2
done
printf '[commit]\n\tscopes = api deps server ui\n' >"$repo/.starling.conf"

# expect DIR NAME WANT_STATUS WANT_TEXT COMMAND ARGS...: run the command in DIR.
expect() {
	dir=$1 name=$2 want_status=$3 want=$4
	shift 4
	out=$(cd "$dir" && run "$@" 2>&1)
	status=$?
	if [ "$status" -eq "$want_status" ] && { [ -z "$want" ] || printf '%s\n' "$out" | grep -qF -- "$want"; }; then ok; else
		bad "$name" "expected exit $want_status and \"$want\", got exit $status:
$out"
	fi
}

# Messages, checked as the commit-msg hook checks them.
for msg in "$msgs"/*.msg; do
	name=$(basename "$msg" .msg)
	if [ -f "${msg%.msg}.expect" ]; then
		expect "$repo" "$name" 1 "$(cat "${msg%.msg}.expect")" "$check" "$msg"
	else
		expect "$repo" "$name" 0 "" "$check" "$msg"
	fi
done

# The hook passes the message file on to the checker.
expect "$repo" "hook: valid message" 0 "" "$hook" "$msgs/valid-full.msg"
expect "$repo" "hook: invalid message" 1 'type `chore` is not allowed' "$hook" "$msgs/chore.msg"

# Usage errors.
expect "$repo" "usage: no arguments" 2 "usage:" "$check"

# Every .starling/ path that Starling's instructions and documentation name
# exists, except placeholders such as .starling/skills/<name>/ and
# .starling/** and .starling/VERSION, which the installer writes.
missing=$({ find "$root/.starling" "$root/docs" -name '*.md' && echo "$root/README.md"; } | while read -r md; do
	awk '{
		s = $0
		while (match(s, /`\.starling\/[^` "]*/)) {
			print substr(s, RSTART + 1, RLENGTH - 1)
			s = substr(s, RSTART + RLENGTH)
		}
	}' "$md" | while read -r path; do
		case $path in (*'<'* | *'*'* | .starling/VERSION) continue ;; esac
		[ -e "$root/$path" ] || echo "${md#"$root"/} names $path"
	done
done)
if [ -z "$missing" ]; then ok; else bad "instructions: named paths exist" "$missing"; fi

# The README lists every skill.
missing=$(for dir in "$root"/.starling/skills/*/; do
	name=$(basename "$dir")
	grep -q "^| \`$name\`" "$root/README.md" || echo "$name"
done)
if [ -z "$missing" ]; then ok; else bad "readme: lists every skill" "$missing"; fi

# Claude Code resolves an @ import only where the path ends the line or is
# followed by a space: in "@.starling/AGENTS.md." the period becomes part of
# the path.
if grep -q ' @\.starling/AGENTS\.md$' "$root/AGENTS.md"; then ok; else
	bad "instructions: import line" "AGENTS.md needs a line ending in ' @.starling/AGENTS.md'"
fi

# Starling uses its own Claude Code settings, as the installer writes them.
if cmp -s "$root/.claude/settings.json" "$root/.starling/claude-settings.json"; then ok; else
	bad "settings: .claude/settings.json" "differs from .starling/claude-settings.json"
fi

# Starling checks its own commits with the workflow the installer installs.
if cmp -s "$root/.github/workflows/starling-commits.yml" "$root/.starling/workflows/github/starling-commits.yml"; then ok; else
	bad "workflow: .github/workflows/starling-commits.yml" "differs from .starling/workflows/github/starling-commits.yml"
fi

# Starling uses its own skills, linked as the installer links them.
for skill in "$root"/.starling/skills/*/; do
	name=$(basename "$skill")
	for dir in .claude/skills .agents/skills; do
		if [ "$(cd "$root/$dir/$name" 2>/dev/null && pwd -P)" = "$(cd "$skill" && pwd -P)" ]; then ok; else
			bad "skills: $dir/$name" "expected a link to ../../.starling/skills/$name"
		fi
	done
done

# test-skill's lint. tests/skills/NAME is a skill: without NAME.expect the
# lint must pass it silently; with NAME.expect it must fail and print every
# line of that file. Starling's own skills must pass.
lint="$root/.starling/skills/test-skill/scripts/lint"
for skill in "$root"/tests/skills/*/; do
	name=$(basename "$skill")
	out=$(cd "$root" && run "$lint" "$skill" 2>&1)
	status=$?
	if [ -f "$root/tests/skills/$name.expect" ]; then
		missing=
		while IFS= read -r want; do
			printf '%s\n' "$out" | grep -qF -- "$want" || missing="$missing  $want
"
		done <"$root/tests/skills/$name.expect"
		if [ "$status" -eq 1 ] && [ -z "$missing" ]; then ok; else
			bad "lint: $name" "exit $status; missing:
$missing
got:
$out"
		fi
	elif [ "$status" -eq 0 ] && [ -z "$out" ]; then ok; else
		bad "lint: $name" "expected no findings, got exit $status:
$out"
	fi
done
expect "$root" "lint: Starling's own skills" 0 "" "$lint"
if [ -z "$out" ]; then ok; else bad "lint: Starling's own skills are silent" "$out"; fi
long=$tmp/skills/review-long
{
	mkdir -p "$long" "$tmp/skills/notes" && cp "$root/tests/skills/review-widgets/SKILL.md" "$long/SKILL.md" &&
		awk 'BEGIN { for (i = 0; i < 500; i++) print "Line." }' >>"$long/SKILL.md" &&
		sed 's/review-widgets/review-long/' "$long/SKILL.md" >"$long/SKILL.md.new" && mv "$long/SKILL.md.new" "$long/SKILL.md" &&
		mkdir -p "$long/scripts" "$long/references" && cp -p "$root/tests/skills/review-widgets/scripts/"* "$long/scripts/" &&
		cp "$root/tests/skills/review-widgets/references/"* "$long/references/"
} || exit 2
expect "$root" "lint: a long SKILL.md" 1 "keep it under 500" "$lint" "$long"
expect "$root" "lint: a directory of skills" 1 "notes: has no SKILL.md" "$lint" "$tmp/skills"
expect "$root" "lint: neither skill nor directory" 2 "neither a skill nor a directory of skills" "$lint" "$tmp/none"
expect "$tmp" "lint: outside a repository" 2 "not inside a git work tree" "$lint"
expect "$root" "lint: options" 2 "usage: lint" "$lint" --help

# In a project, the lint checks the project's own skills: real directories in
# .agents/skills and .claude/skills, not Starling's or links.
proj=$tmp/proj
{
	git init -q "$proj" && mkdir -p "$proj/.agents/skills" "$proj/.claude/skills" "$proj/.starling/skills" &&
		cp -R "$root/tests/skills/fetch-widgets" "$proj/.agents/skills/" &&
		ln -s ../../.agents/skills/fetch-widgets "$proj/.claude/skills/fetch-widgets" &&
		cp -R "$root/tests/skills/review-mismatch" "$proj/.starling/skills/" &&
		echo v0.0.0 >"$proj/.starling/VERSION"
} || exit 2
expect "$proj" "lint: a project's own skills" 1 ".agents/skills/fetch-widgets/SKILL.md:2:" "$lint"
if printf '%s\n' "$out" | grep -q 'review-mismatch\|\.claude/skills'; then
	bad "lint: not Starling's skills or links in a project" "$out"
else ok; fi

# The lint's verbs are the naming table's in write-skill's rules.
rules="$root/.starling/skills/write-skill/references/rules.md"
table=$(sed -n 's/^| `\([a-z]*\)-` .*/\1/p' "$rules" | sort | tr '\n' ' ')
script=$(sed -n "s/^verbs='\(.*\)'$/\1/p" "$lint" | tr ' ' '\n' | sort | tr '\n' ' ')
if [ -n "$table" ] && [ "$table" = "$script" ]; then ok; else
	bad "lint: the verbs of the naming table" "rules: $table
lint: $script"
fi

# The write-skill context script, in Starling and in the project above.
wcontext="$root/.starling/skills/write-skill/scripts/context"
expect "$root" "write-skill context: Starling" 0 "Repository: Starling itself" "$wcontext"
expect "$root" "write-skill context: Starling's eval setup" 0 \
	"Eval setup: .claude-plugin/plugin.json loads ./.starling/skills" "$wcontext"
expect "$root" "write-skill context: Starling's skills" 0 "  commit-changes (Starling's own): Commits the changes" "$wcontext"
{
	mkdir -p "$proj/.claude/skills/review-old" "$proj/.agents/skills/review-unlinked" &&
		cp "$root/tests/skills/review-widgets/SKILL.md" "$proj/.claude/skills/review-old/SKILL.md" &&
		cp "$root/tests/skills/review-widgets/SKILL.md" "$proj/.agents/skills/review-unlinked/SKILL.md" &&
		ln -s ../../.agents/skills/review-gone "$proj/.claude/skills/review-gone"
} || exit 2
expect "$proj" "write-skill context: a project" 0 "Repository: a project with Starling v0.0.0" "$wcontext"
expect "$proj" "write-skill context: where a project's skills go" 0 \
	"New skills go in: .agents/skills/<name>/, linked from .claude/skills/<name>" "$wcontext"
expect "$proj" "write-skill context: no eval setup" 0 "Eval setup: none" "$wcontext"
expect "$proj" "write-skill context: a project skill" 0 "  fetch-widgets (.agents/skills): Reviews widgets" "$wcontext"
expect "$proj" "write-skill context: Starling's skill" 0 "  review-mismatch (Starling): Reviews widgets" "$wcontext"
expect "$proj" "write-skill context: a skill to move" 0 "move it to .agents/skills" "$wcontext"
expect "$proj" "write-skill context: a skill not linked" 0 \
	"not linked from .claude/skills/review-unlinked" "$wcontext"
expect "$proj" "write-skill context: a broken link" 0 "the link .claude/skills/review-gone is broken" "$wcontext"
mkdir -p "$proj/.claude-plugin" && printf '{"name": "proj", "skills": "./skills"}\n' >"$proj/.claude-plugin/plugin.json"
expect "$proj" "write-skill context: a manifest elsewhere" 0 "does not load .agents/skills" "$wcontext"
mkdir -p "$proj/.agents/policy" && echo "# Labels" >"$proj/.agents/policy/fetch-widgets.md" &&
	echo "# Old" >"$proj/.agents/policy/review-retired.md" || exit 2
expect "$proj" "write-skill context: a policy file" 0 "  .agents/policy/fetch-widgets.md" "$wcontext"
expect "$proj" "write-skill context: a policy file for no skill" 0 \
	".agents/policy/review-retired.md: no skill is named review-retired" "$wcontext"
expect "$root" "write-skill context: no policy files" 0 "Policy files:" "$wcontext"
if [ "$(printf '%s\n' "$out" | tail -n 1)" = "  none" ]; then ok; else
	bad "write-skill context: no policy files listed" "$out"
fi
expect "$tmp" "write-skill context: outside a repository" 2 "not inside a git work tree" "$wcontext"

# The forge wrapper. The forge comes from .starling.conf, else from the
# origin remote's host.
forge="$root/.starling/bin/forge"
fg=$tmp/forge
git init -q -b main "$fg" || exit 2
expect "$fg" "forge: no remote" 1 "the origin remote names no host" "$forge" kind
git -C "$fg" remote add origin https://github.com/example/widgets.git || exit 2
expect "$fg" "forge: GitHub over https" 0 "github" "$forge" kind
git -C "$fg" remote set-url origin git@github.com:example/widgets.git
expect "$fg" "forge: GitHub over ssh" 0 "github" "$forge" kind
git -C "$fg" remote set-url origin https://git.example.org/example/widgets.git
expect "$fg" "forge: another host is Forgejo" 0 "forgejo" "$forge" kind
printf '[forge]\n\tkind = github\n' >"$fg/.starling.conf"
expect "$fg" "forge: kind from .starling.conf" 0 "github" "$forge" kind
printf '[forge]\n\tkind = gitlab\n' >"$fg/.starling.conf"
expect "$fg" "forge: an unknown kind" 2 "must be github or forgejo" "$forge" kind
rm "$fg/.starling.conf"
expect "$fg" "forge: usage" 2 "usage: forge" "$forge" nope
expect "$fg" "forge: api without a path" 2 "usage: forge" "$forge" api
expect "$tmp" "forge: outside a repository" 1 "not inside a git work tree" "$forge" kind

# On Forgejo, against a fake curl that records its arguments and its
# standard input, and answers from the file FAKE_CURL names: the response's
# body, then its status on its last line. jq is the real one.
if command -v jq >/dev/null 2>&1; then
	mkdir -p "$tmp/curlbin" && cat >"$tmp/curlbin/curl" <<'EOF'
#!/bin/sh
# What the wrapper asks about the repository itself is answered apart, so
# that the recorded call is the one a test made.
for last; do :; done
case $last in
*/api/v1/repos/example/widgets)
	cat >/dev/null
	printf '{"full_name": "example/widgets", "fork": false, "default_branch": "main"}\n200'
	exit
	;;
esac
printf '%s\n' "$@" >"$FAKE_CURL.args"
cat >"$FAKE_CURL.stdin"
# With a folder of answers, each call is answered by the file named after
# its path below the repository, with _ for / and without the query.
if [ -d "$FAKE_CURL.d" ]; then
	name=${last#*/repos/example/widgets/}
	name=$(printf '%s' "${name%%\?*}" | tr / _)
	printf '%s %s\n' "$3" "$name" >>"$FAKE_CURL.calls"
	if [ -f "$FAKE_CURL.d/$name" ]; then cat "$FAKE_CURL.d/$name"; else printf '{"message": "no answer for %s"}\n404' "$name"; fi
	exit
fi
cat "$FAKE_CURL"
EOF
	chmod +x "$tmp/curlbin/curl"
	forgejo() { # ARGS...: run forge in $fg with the fake curl
		out=$(cd "$fg" && PATH="$tmp/curlbin:$PATH" FAKE_CURL="$tmp/curl-answer" FORGEJO_TOKEN=${token-s3cret} &&
			export PATH FAKE_CURL FORGEJO_TOKEN && run "$forge" "$@" 2>&1)
	}
	curl_got() { # NAME WANT: the last call's arguments have the line WANT
		if grep -qxF -- "$2" "$tmp/curl-answer.args"; then ok; else
			bad "forge: $1" "expected the argument \"$2\" in:
$(cat "$tmp/curl-answer.args")"
		fi
	}
	printf '{"login": "bot"}\n200' >"$tmp/curl-answer"
	forgejo api user
	if [ $? -eq 0 ] && [ "$out" = '{"login": "bot"}' ]; then ok; else bad "forge: api prints the response" "$out"; fi
	curl_got "api at the remote's host" "https://git.example.org/api/v1/user"
	curl_got "api defaults to GET" "GET"
	if grep -qx 'header = "Authorization: token s3cret"' "$tmp/curl-answer.stdin" &&
		! grep -q s3cret "$tmp/curl-answer.args"; then ok; else
		bad "forge: the token goes to curl on standard input" "$(cat "$tmp/curl-answer.args" "$tmp/curl-answer.stdin")"
	fi
	forgejo api '/repos/{owner}/{repo}/pulls/7'
	curl_got "api fills in the repository" "https://git.example.org/api/v1/repos/example/widgets/pulls/7"
	echo '{"title": "Add widgets"}' >"$tmp/curl-body"
	forgejo api --input "$tmp/curl-body" 'repos/{owner}/{repo}/pulls'
	curl_got "api sends a body" '{"title": "Add widgets"}'
	curl_got "api posts a body" "POST"
	forgejo api -X PATCH --input "$tmp/curl-body" 'repos/{owner}/{repo}/pulls/7'
	curl_got "api with a method" "PATCH"
	printf '{"message": "The target could not be found."}\n404' >"$tmp/curl-answer"
	forgejo api repos/example/none
	if [ $? -eq 1 ] && [ "$out" = "forge: GET repos/example/none: HTTP 404: The target could not be found." ]; then ok; else
		bad "forge: api reports a refusal" "$out"
	fi
	printf '{}\n200' >"$tmp/curl-answer"
	git -C "$fg" remote set-url origin ssh://git@git.example.org:2222/example/widgets.git
	forgejo api user
	curl_got "an ssh remote means https without its port" "https://git.example.org/api/v1/user"
	git -C "$fg" remote set-url origin http://localhost:3000/forge/example/widgets
	forgejo api 'repos/{owner}/{repo}/pulls'
	curl_got "a remote below a path" "http://localhost:3000/forge/api/v1/repos/example/widgets/pulls"
	printf '[forge]\n\turl = https://forge.example.org/\n' >"$fg/.starling.conf"
	forgejo api user
	curl_got "forge.url in .starling.conf" "https://forge.example.org/api/v1/user"
	git -C "$fg" config credential.helper \
		'!f() { test "$1" = get && cat >"$FAKE_CURL.cred" && echo username=bot && echo password=fr0mgit; }; f'
	token='' forgejo api user
	if grep -qx 'header = "Authorization: token fr0mgit"' "$tmp/curl-answer.stdin" &&
		grep -qx 'host=forge.example.org' "$tmp/curl-answer.cred"; then ok; else
		bad "forge: the token from git's credential helper" "$out
$(cat "$tmp/curl-answer.stdin" "$tmp/curl-answer.cred" 2>&1)"
	fi
	git -C "$fg" config credential.helper ''
	token='' forgejo api user
	if [ $? -eq 1 ] && printf '%s\n' "$out" | grep -qF "no token for https://forge.example.org: set FORGEJO_TOKEN"; then ok; else
		bad "forge: no token" "$out"
	fi
	unset token
	rm "$fg/.starling.conf"

	# Pull requests on Forgejo. #7 is a draft, #8 is ready and behind its
	# base, #9 is merged.
	git -C "$fg" config --unset-all credential.helper
	git -C "$fg" remote set-url origin https://git.example.org/example/widgets.git
	ans=$tmp/curl-answer.d
	mkdir -p "$ans" || exit 2
	pull() { # NUMBER TITLE DRAFT STATE MERGED BRANCH MERGE_BASE
		printf '{"number": %s, "title": "%s", "draft": %s, "state": "%s", "merged": %s, "body": "Adds widgets.\\nCloses #3", "html_url": "https://git.example.org/example/widgets/pulls/%s", "head": {"ref": "%s", "sha": "%s0000"}, "base": {"ref": "main", "sha": "base0000"}, "merge_base": "%s"}' \
			"$1" "$2" "$3" "$4" "$5" "$1" "$6" "$6" "$7"
	}
	{ pull 7 "WIP: Add widgets" true open false topic base0000 && printf '\n200'; } >"$ans/pulls_7"
	{ pull 8 "Fix the lobby" false open false lobby old00000 && printf '\n200'; } >"$ans/pulls_8"
	{ printf '[' && pull 7 "[wip] Add widgets" true open false topic base0000 && printf ',' &&
		pull 8 "Fix the lobby" false open false lobby old00000 && printf ']\n200'; } >"$ans/pulls"
	printf '[{"sha": "bbbbbbbbbbbb", "commit": {"message": "fixup! feat: add widgets"}}, {"sha": "aaaaaaaaaaaa", "commit": {"message": "feat: add widgets\\n\\nBody."}}]\n200' >"$ans/pulls_7_commits"
	forgejo pr view 7
	want='Number: 7
URL: https://git.example.org/example/widgets/pulls/7
State: open
Draft: yes
Title: Add widgets
Head: topic
Head commit: topic0000
Base: main
Behind base: no
Commits:
  aaaaaaaaa feat: add widgets
  bbbbbbbbb fixup! feat: add widgets'
	if [ "$out" = "$want" ]; then ok; else bad "forge: pr view on Forgejo" "$out"; fi
	forgejo pr view 7 --body
	if [ "$(printf '%s\n' "$out" | tail -n 3)" = 'Body:
Adds widgets.
Closes #3' ]; then ok; else bad "forge: pr view --body" "$out"; fi
	cp "$ans/pulls_7_commits" "$ans/pulls_8_commits"
	forgejo pr view 8
	if printf '%s\n' "$out" | grep -qx 'Behind base: yes'; then ok; else bad "forge: a pull request behind its base" "$out"; fi
	git -C "$fg" checkout -q -b topic 2>/dev/null
	forgejo pr view
	if printf '%s\n' "$out" | grep -qx 'Number: 7'; then ok; else bad "forge: pr view of the current branch" "$out"; fi
	forgejo pr list
	if [ "$out" = '#7 draft topic0000 https://git.example.org/example/widgets/pulls/7 Add widgets
#8 ready lobby0000 https://git.example.org/example/widgets/pulls/8 Fix the lobby' ]; then ok; else
		bad "forge: pr list on Forgejo" "$out"
	fi
	forgejo pr list --head lobby
	if [ "$out" = '#8 ready lobby0000 https://git.example.org/example/widgets/pulls/8 Fix the lobby' ]; then ok; else
		bad "forge: pr list --head" "$out"
	fi
	forgejo pr list --search 'closes #3' --head topic
	if [ "$(printf '%s\n' "$out" | grep -c .)" = 1 ]; then ok; else bad "forge: pr list --search" "$out"; fi
	{ printf '[' && pull 9 "Add a host" false closed true host base0000 && printf ',' &&
		pull 10 "Drop it" false closed false drop base0000 && printf ']\n200'; } >"$ans/pulls"
	forgejo pr list --state merged
	if [ "$out" = '#9 merged host0000 https://git.example.org/example/widgets/pulls/9 Add a host' ]; then ok; else
		bad "forge: pr list --state merged" "$out"
	fi
	curl_got "merged pull requests are among the closed" \
		"https://git.example.org/api/v1/repos/example/widgets/pulls?state=closed&sort=recentupdate&limit=50&page=1"
	sent() { # NAME WANT: the last call's body, as compact JSON, is WANT
		got=$(grep '^{' "$tmp/curl-answer.args" | jq -c . 2>&1)
		if [ "$got" = "$2" ]; then ok; else bad "forge: $1" "sent: $got"; fi
	}
	printf 'Adds widgets.\n' >"$tmp/pr-body"
	printf '{"html_url": "https://git.example.org/example/widgets/pulls/11"}\n201' >"$ans/pulls"
	forgejo pr create --draft --title "Add widgets" --body-file "$tmp/pr-body"
	if [ "$out" = "https://git.example.org/example/widgets/pulls/11" ]; then ok; else bad "forge: pr create prints the URL" "$out"; fi
	sent "pr create --draft on Forgejo" '{"title":"WIP: Add widgets","body":"Adds widgets.\n","head":"topic","base":"main"}'
	forgejo pr create --base develop --head other --title "Add widgets" --body-file "$tmp/pr-body"
	sent "pr create with a base and a head" '{"title":"Add widgets","body":"Adds widgets.\n","head":"other","base":"develop"}'
	forgejo pr edit 7 --title "Add more widgets"
	sent "pr edit keeps a draft a draft" '{"title":"WIP: Add more widgets"}'
	forgejo pr edit 8 --title "Fix it" --body-file "$tmp/pr-body" --base develop
	sent "pr edit of a ready pull request" '{"title":"Fix it","base":"develop","body":"Adds widgets.\n"}'
	forgejo pr ready 7
	sent "pr ready removes the prefix" '{"title":"Add widgets"}'
	: >"$tmp/curl-answer.calls"
	forgejo pr ready 8
	if grep -q '^PATCH' "$tmp/curl-answer.calls"; then bad "forge: pr ready leaves a ready pull request" "$(cat "$tmp/curl-answer.calls")"; else ok; fi
	status() { # ID CONTEXT STATUS
		printf '{"id": %s, "context": "%s", "status": "%s", "target_url": "/example/widgets/actions/runs/%s/jobs/0"}' "$1" "$2" "$3" "$1"
	}
	{ printf '{"statuses": [' && status 31 build success && printf ',' && status 32 lint skipped && printf ']}\n200'; } >"$ans/commits_topic0000_status"
	forgejo pr checks 7
	if [ $? -eq 0 ] && [ "$out" = 'build	pass	https://git.example.org/example/widgets/actions/runs/31/jobs/0
lint	skipped	https://git.example.org/example/widgets/actions/runs/32/jobs/0' ]; then ok; else
		bad "forge: pr checks, green" "$out"
	fi
	forgejo runs topic0000
	if [ "$out" = '31 completed
32 completed' ]; then ok; else bad "forge: runs on Forgejo" "$out"; fi
	{ printf '{"statuses": [' && status 31 build failure && printf ',' && status 33 lint pending && printf ']}\n200'; } >"$ans/commits_topic0000_status"
	forgejo pr checks 7
	if [ $? -eq 1 ] && printf '%s\n' "$out" | grep -q '^build	fail	' && printf '%s\n' "$out" | grep -q '^lint	pending	'; then ok; else
		bad "forge: pr checks, red" "$out"
	fi
	forgejo runs topic0000
	if [ "$out" = '31 completed
33 pending' ]; then ok; else bad "forge: a pending run" "$out"; fi
	printf '{"statuses": []}\n200' >"$ans/commits_topic0000_status"
	forgejo pr checks 7
	if [ $? -eq 1 ] && [ "$out" = "forge: no checks on #7" ]; then ok; else bad "forge: pr checks without checks" "$out"; fi
	printf '{"number": 3, "title": "Lobby crashes", "state": "open", "user": {"login": "ada"}, "labels": [{"name": "bug"}, {"name": "lobby"}], "body": "It crashes."}\n200' >"$ans/issues_3"
	printf '[{"user": {"login": "grace"}, "created_at": "2026-01-02T03:04:05Z", "body": "Confirmed."}]\n200' >"$ans/issues_3_comments"
	forgejo issue view '#3'
	want='title:	Lobby crashes
state:	open
author:	ada
labels:	bug, lobby
number:	3
--
It crashes.
--
author:	grace
created:	2026-01-02T03:04:05Z
--
Confirmed.'
	if [ "$out" = "$want" ]; then ok; else bad "forge: issue view on Forgejo" "$out"; fi
	forgejo pr view seven
	if [ $? -eq 2 ]; then ok; else bad "forge: a pull request that is no number" "$out"; fi
	forgejo pr create --title "No body"
	if [ $? -eq 2 ]; then ok; else bad "forge: pr create without a body" "$out"; fi

	# A fork: issues and pull requests are the parent's, and a pull request
	# comes from the fork's branch.
	git -C "$fg" remote set-url origin https://git.example.org/bot/widgets.git
	mkdir -p "$tmp/forkbin" && cat >"$tmp/forkbin/curl" <<'EOF'
#!/bin/sh
for last; do :; done
cat >/dev/null
case $last in
*/repos/bot/widgets) printf '{"full_name": "bot/widgets", "fork": true, "owner": {"login": "bot"}, "parent": {"full_name": "example/widgets", "default_branch": "trunk"}}\n200' ;;
*)
	printf '%s\n' "$@" >"$FAKE_CURL.args"
	printf '{"html_url": "https://git.example.org/example/widgets/pulls/12"}\n201'
	;;
esac
EOF
	chmod +x "$tmp/forkbin/curl"
	out=$(cd "$fg" && PATH="$tmp/forkbin:$PATH" FAKE_CURL="$tmp/curl-answer" FORGEJO_TOKEN=s3cret &&
		export PATH FAKE_CURL FORGEJO_TOKEN && run "$forge" pr create --title "Add widgets" --body-file "$tmp/pr-body" 2>&1)
	curl_got "a fork's pull request goes to the parent" "https://git.example.org/api/v1/repos/example/widgets/pulls"
	sent "a fork's pull request names its owner" '{"title":"Add widgets","body":"Adds widgets.\n","head":"bot:topic","base":"trunk"}'
	git -C "$fg" checkout -q main 2>/dev/null
fi

# On GitHub, the wrapper runs gh. A fake gh prints its arguments, one per
# line, and the --jq filter is not run.
mkdir -p "$tmp/ghapibin" && printf '#!/bin/sh\nprintf "%%s\\n" "$@"\n' >"$tmp/ghapibin/gh" && chmod +x "$tmp/ghapibin/gh"
git -C "$fg" remote set-url origin https://github.com/example/widgets.git
github() { # ARGS...: run forge in $fg with the fake gh, its arguments on one line
	out=$(cd "$fg" && PATH="$tmp/ghapibin:$PATH" run "$forge" "$@" 2>&1 | tr '\n' ' ')
}
gh_ran() { # NAME WANT: the last call started with WANT
	case $out in
	"$2"*) ok ;;
	*) bad "forge: $1" "$out" ;;
	esac
}
github pr view 7
gh_ran "pr view on GitHub" "pr view 7 --json number,url,state,isDraft,title,headRefName,headRefOid,baseRefName,mergeStateStatus,commits,body --jq "
github pr list --state merged --head topic
gh_ran "pr list on GitHub" "pr list --state merged --limit 50 --head topic --json "
github pr list --search 12
gh_ran "pr list --search on GitHub" "pr list --state open --limit 50 --search 12 in:title,body --json "
: >"$fg/body.md"
github pr create --draft --base develop --title "Add widgets" --body-file body.md
gh_ran "pr create on GitHub" "pr create --draft --base develop --title Add widgets --body-file body.md "
rm "$fg/body.md"
github pr edit 7 --title "Add widgets"
if [ -z "$out" ]; then ok; else bad "forge: pr edit on GitHub is silent" "$out"; fi
github pr checkout 7
gh_ran "pr checkout on GitHub" "pr checkout 7 "
github runs abc123
gh_ran "runs on GitHub" "run list --commit abc123 --limit 50 --json databaseId,status --jq "
github issue view 12
gh_ran "issue view on GitHub" "issue view 12 --json number,title,state,author,labels,body,comments --jq "
github pr checks 7
if printf '%s' "$out" | grep -q '^forge: no checks on #7'; then ok; else bad "forge: pr checks on GitHub without a list" "$out"; fi

# On GitHub, api hands over to gh.
out=$(cd "$fg" && PATH="$tmp/ghapibin:$PATH" run "$forge" api -X PATCH --input body.json 'repos/{owner}/{repo}/pulls/7' 2>&1)
if [ "$out" = 'api
-X
PATCH
--input
body.json
repos/{owner}/{repo}/pulls/7' ]; then ok; else bad "forge: api on GitHub runs gh api" "$out"; fi

# triage-issue's relations script, against a fake gh that answers by path.
relations="$root/.starling/skills/triage-issue/scripts/relations"
mkdir -p "$tmp/fakebin" && cat >"$tmp/fakebin/gh" <<'EOF'
#!/bin/sh
case $2 in
*/12/dependencies/blocked_by*) echo "#3 open Fix the lobby crash" ;;
*/12/dependencies/blocking*) ;;
*/12/parent) echo "#1 open Lobbies" ;;
*/12/sub_issues*) printf '#13 closed Show the host\n#14 open Kick a player\n' ;;
*/13/parent) echo "gh: Not Found (HTTP 404)" >&2; exit 1 ;;
*/13/*) ;;
*) echo "gh: Server Error (HTTP 500)" >&2; exit 1 ;;
esac
EOF
chmod +x "$tmp/fakebin/gh"
out=$(cd "$repo" && PATH="$tmp/fakebin:$PATH" run "$relations" 12 2>&1)
want='Blocked by:
  #3 open Fix the lobby crash
Blocking:
  none
Parent:
  #1 open Lobbies
Sub-issues:
  #13 closed Show the host
  #14 open Kick a player'
if [ "$out" = "$want" ]; then ok; else bad "relations: an issue with relationships" "$out"; fi
out=$(cd "$repo" && PATH="$tmp/fakebin:$PATH" run "$relations" 13 2>&1)
if [ "$(printf '%s\n' "$out" | grep -c '^  none$')" = 4 ]; then ok; else
	bad "relations: an issue without any" "$out"
fi
out=$(cd "$repo" && PATH="$tmp/fakebin:$PATH" run "$relations" 99 2>&1)
if [ $? -eq 1 ] && printf '%s\n' "$out" | grep -qF 'cannot read "Blocked by" for #99'; then ok; else
	bad "relations: GitHub fails" "$out"
fi
expect "$repo" "relations: usage" 2 "usage: relations ISSUE" "$relations" twelve

# finish-pr's wait-ci script, against a fake forge wrapper that keeps the
# pull request's state in files: head (the head commit, or move, the one it
# moves to once its runs are read as finished), runs (one "id state" line per
# run; reading them finishes the pending ones), checks (lines with pass or
# fail), subjects, and on-ready (runs that marking it ready starts).
waitci="$root/.starling/skills/finish-pr/scripts/wait-ci"
mkdir -p "$tmp/cibin" && cat >"$tmp/cibin/forge" <<'EOF'
#!/bin/sh
s=$FAKE_CI
case "$1 $2" in
"pr view")
	echo "Number: $3"
	echo "Head commit: $(cat "$s/head")"
	echo "Commits:"
	sed 's/^/  0123abc /' "$s/subjects"
	;;
"runs abc123")
	cat "$s/runs"
	if grep -q pending "$s/runs"; then
		sed 's/pending/completed/' "$s/runs" >"$s/runs.new" && mv "$s/runs.new" "$s/runs"
	elif [ -f "$s/move" ]; then mv "$s/move" "$s/head"; fi
	;;
"pr checks")
	cat "$s/checks"
	if grep -q fail "$s/checks"; then exit 1; fi
	;;
"pr ready")
	touch "$s/ready"
	if [ -f "$s/on-ready" ]; then cat "$s/on-ready" >>"$s/runs"; fi
	;;
*)
	echo "fake forge: $*" >&2
	exit 1
	;;
esac
EOF
chmod +x "$tmp/cibin/forge"
ci_state() { # RUNS CHECKS [SUBJECTS]
	rm -rf "$tmp/ci" && mkdir "$tmp/ci" && echo abc123 >"$tmp/ci/head" &&
		printf '%s' "$1" >"$tmp/ci/runs" && printf '%s\n' "$2" >"$tmp/ci/checks" &&
		printf '%s' "${3:-}" >"$tmp/ci/subjects" || exit 2
}
wait_ci() { # NAME WANT_STATUS WANT_TEXT ARGS...
	name=$1 want_status=$2 want=$3
	shift 3
	out=$(
		cd "$repo" || exit 2
		STARLING_FORGE="$tmp/cibin/forge" FAKE_CI="$tmp/ci" WAIT_CI_POLL=0 WAIT_CI_LIMIT=1
		export STARLING_FORGE FAKE_CI WAIT_CI_POLL WAIT_CI_LIMIT
		run "$waitci" "$@" 2>&1
	)
	status=$?
	if [ "$status" -eq "$want_status" ] && printf '%s\n' "$out" | grep -qF -- "$want"; then ok; else
		bad "$name" "expected exit $want_status and \"$want\", got exit $status:
$out"
	fi
}
wait_ci "wait-ci: no pull request" 2 "usage: wait-ci PR" ""
wait_ci "wait-ci: not a number" 2 "usage: wait-ci PR" abc
wait_ci "wait-ci: two pull requests" 2 "usage: wait-ci PR" 7 8
ci_state '101 pending
' 'build	pass'
wait_ci "wait-ci: green" 0 "#7 head abc123" 7
ci_state '101 pending
' 'build	fail'
wait_ci "wait-ci: red" 1 "build	fail" 7
ci_state '101 completed
' 'build	pass' 'feat: add widgets
fixup! feat: add widgets'
wait_ci "wait-ci: fixups refused" 1 "fixup! feat: add widgets" 7 --mark-ready
ci_state '101 completed
' 'build	pass'
printf '200 pending\n' >"$tmp/ci/on-ready"
wait_ci "wait-ci: marks ready and waits" 0 "build	pass" 7 --mark-ready
if [ -f "$tmp/ci/ready" ] && grep -qx '200 completed' "$tmp/ci/runs"; then ok; else
	bad "wait-ci: watched the runs marking it ready started" "$(cat "$tmp/ci/runs")"
fi
ci_state '101 completed
' 'build	fail'
wait_ci "wait-ci: a red draft stays a draft" 1 "not marking it ready" 7 --mark-ready
if [ ! -f "$tmp/ci/ready" ]; then ok; else bad "wait-ci: a red draft is not marked ready" "marked ready"; fi
ci_state '101 completed
' 'build	pass'
wait_ci "wait-ci: no runs on ready" 0 "its checks stand" 7 --mark-ready
ci_state '101 pending
' 'build	pass'
echo def456 >"$tmp/ci/move"
wait_ci "wait-ci: the head moved" 4 "moved to def456" 7
ci_state '' 'build	pass'
wait_ci "wait-ci: no runs at all" 3 "no run appeared on abc123" 7

# resolve-review-threads' threads script, against a fake gh that records its
# arguments. GitHub's GraphQL and jq are not run here.
threads="$root/.starling/skills/resolve-review-threads/scripts/threads"
mkdir -p "$tmp/threadbin" && cat >"$tmp/threadbin/gh" <<'EOF'
#!/bin/sh
printf '%s\n' "$@" >"$FAKE_ARGS"
case "$*" in *pr=99*) echo "gh: Server Error (HTTP 500)" >&2; exit 1 ;; esac
echo "No unresolved review threads."
EOF
chmod +x "$tmp/threadbin/gh"
list_threads() { # ARGS...
	out=$(cd "$repo" && PATH="$tmp/threadbin:$PATH" FAKE_ARGS="$tmp/threadargs" && export PATH FAKE_ARGS && run "$threads" "$@" 2>&1)
}
list_threads 12
if [ $? -eq 0 ] && grep -qx 'pr=12' "$tmp/threadargs" && grep -qx 'owner={owner}' "$tmp/threadargs" &&
	grep -q '^false as \$all' "$tmp/threadargs"; then ok; else
	bad "threads: asks GitHub for the unresolved threads" "$out
$(cat "$tmp/threadargs")"
fi
list_threads 12 --all
if grep -q '^true as \$all' "$tmp/threadargs"; then ok; else bad "threads: --all" "$(cat "$tmp/threadargs")"; fi
list_threads 99
if [ $? -eq 1 ] && printf '%s\n' "$out" | grep -qF "cannot read the review threads of #99"; then ok; else
	bad "threads: GitHub fails" "$out"
fi
list_threads twelve
if [ $? -eq 2 ] && printf '%s\n' "$out" | grep -qF "usage: threads PR"; then ok; else bad "threads: usage" "$out"; fi

# clean-merged-branches' report script, on a real repository. A fake forge
# wrapper answers for merged pull requests from files named after the
# branch.
report="$root/.starling/skills/clean-merged-branches/scripts/report"
br=$tmp/branches
br_commit() { # FILE: commit a change to FILE on the current branch
	echo "$1" >>"$br/$1" && git -C "$br" add -A &&
		git -C "$br" -c core.hooksPath=/dev/null -c commit.gpgsign=false commit -q -m "change $1" || exit 2
}
{
	git init -q -b main "$br" && git -C "$br" config user.name Test && git -C "$br" config user.email test@example.com
} || exit 2
br_commit base
git -C "$br" branch contained
git -C "$br" checkout -q -b rebased && br_commit rebased-file
git -C "$br" checkout -q -b unique main && br_commit unique-file
git -C "$br" checkout -q -b squashed main && br_commit squashed-file
git -C "$br" checkout -q -b moved main && br_commit moved-file
git -C "$br" checkout -q -b in-tree main && br_commit in-tree-file
git -C "$br" checkout -q -b dirty-tree main && br_commit dirty-file
git -C "$br" checkout -q main && br_commit main-file
git -C "$br" -c core.hooksPath=/dev/null -c commit.gpgsign=false cherry-pick rebased >/dev/null 2>&1 || exit 2
git -C "$br" worktree add -q "$tmp/in-tree" in-tree && git -C "$br" worktree add -q "$tmp/dirty-tree" dirty-tree || exit 2
echo change >"$tmp/dirty-tree/untracked"
git -C "$br" branch current-one && git -C "$br" checkout -q current-one
mkdir -p "$tmp/reportbin" "$tmp/prs" && cat >"$tmp/reportbin/forge" <<'EOF'
#!/bin/sh
case "$1 $2 $3 $4 $5" in
"pr list --state merged --head") if [ -f "$FAKE_PRS/$6" ]; then cat "$FAKE_PRS/$6"; fi ;;
*) exit 1 ;;
esac
EOF
chmod +x "$tmp/reportbin/forge"
echo "#5 merged $(git -C "$br" rev-parse squashed) https://forge.example/5 Squash it" >"$tmp/prs/squashed"
echo "#6 merged 0123456789abcdef https://forge.example/6 Move it" >"$tmp/prs/moved"
before=$(git -C "$br" for-each-ref)
out=$(cd "$br" && STARLING_FORGE="$tmp/reportbin/forge" FAKE_PRS="$tmp/prs" && export STARLING_FORGE FAKE_PRS && run "$report" --base main 2>&1)
status=$?
if [ "$status" -eq 0 ]; then ok; else bad "report: runs" "exit $status: $out"; fi
report_row() { # NAME BRANCH STATUS EVIDENCE
	line=$(printf '%s\n' "$out" | awk -v b="$2" '$1 == b')
	case $line in
	*" $3 "*"$4"*) ok ;;
	*) bad "report: $1" "wanted $3 and \"$4\", got: $line" ;;
	esac
}
report_row "the base branch" main PROTECTED "base branch (main)"
report_row "the current branch" current-one PROTECTED "checked out here"
report_row "a branch in a worktree" in-tree PROTECTED "checked out in worktree"
report_row "a worktree with changes" dirty-tree PROTECTED "uncommitted changes"
report_row "fully contained" contained CANDIDATE "fully contained in main"
report_row "a rebase merge" rebased CANDIDATE "patch-equivalent to main"
report_row "commits not on the base" unique KEEP "1 commit(s) not on main"
report_row "a squash merge at the tip" squashed CANDIDATE "merged in PR #5 at this tip"
report_row "a merged pull request at another commit" moved KEEP "PR #6 merged at 012345678, not at this tip"
if [ "$before" = "$(git -C "$br" for-each-ref)" ]; then ok; else bad "report: changes nothing" "refs changed"; fi
out=$(cd "$br" && run "$report" --base main --no-forge squashed nothing 2>&1)
report_row "no pull request data" squashed KEEP "no pull request data"
report_row "a missing branch" nothing MISSING "no such local branch"
expect "$br" "report: an unknown base" 2 "base ref not found: nope" "$report" --base nope
expect "$br" "report: an unknown option" 2 "usage: report" "$report" --force
expect "$tmp" "report: outside a repository" 2 "not inside a git repository" "$report"

# open-pr's context script, on a real repository. A fake forge wrapper
# prints the open pull request from a file, and fails without that file.
context="$root/.starling/skills/open-pr/scripts/context"
op=$tmp/open-pr
op_commit() { # FILE MESSAGE: commit a change to FILE on the current branch
	mkdir -p "$(dirname "$op/$1")" && echo "$1" >>"$op/$1" && git -C "$op" add -A &&
		git -C "$op" -c core.hooksPath=/dev/null -c commit.gpgsign=false commit -q -m "$2" || exit 2
}
op_has() { # NAME WANT [BASE]: context exits 0 and prints WANT
	name=$1 want=$2
	shift 2
	out=$(cd "$op" && STARLING_FORGE="$tmp/opbin/forge" FAKE_OPEN_PR="$tmp/op-answer" && export STARLING_FORGE FAKE_OPEN_PR && run "$context" "$@" 2>&1)
	status=$?
	if [ "$status" -eq 0 ] && printf '%s\n' "$out" | grep -qF -- "$want"; then ok; else
		bad "open-pr context: $name" "expected exit 0 and \"$want\", got exit $status:
$out"
	fi
}
mkdir -p "$tmp/opbin" && cat >"$tmp/opbin/forge" <<'EOF'
#!/bin/sh
[ "$1 $2 $3 $4" = "pr list --head topic" ] && [ -f "$FAKE_OPEN_PR" ] || exit 1
cat "$FAKE_OPEN_PR"
EOF
chmod +x "$tmp/opbin/forge"
: >"$tmp/op-answer"
{
	git init -q -b main "$op" && git -C "$op" config user.name Test && git -C "$op" config user.email test@example.com &&
		git init -q --bare "$tmp/op-origin.git" && git -C "$op" remote add origin "$tmp/op-origin.git"
} || exit 2
op_commit base "feat: start"
{ git -C "$op" push -q -u origin main && git -C "$op" remote set-head origin main; } || exit 2

op_has "the default branch" "Branch: main, the default branch"
git -C "$op" checkout -q -b topic || exit 2
op_commit topic-file "feat: add a topic

Refs: #12"
op_has "a branch never pushed" "Branch: topic, never pushed"
op_has "commits ahead" "Base: origin/main, 1 commit(s) ahead, 0 behind"
op_has "the commits" "feat: add a topic"
op_has "the issues they name" "Refs: #12"
op_has "no template" "Template: none"
op_has "no open pull request" "Pull request: none"
echo '#7 draft 0123abc https://forge.example/7 Add a topic' >"$tmp/op-answer"
op_has "an open pull request" "Pull request: #7 draft https://forge.example/7"
rm "$tmp/op-answer"
op_has "the forge fails" "Pull request: unknown"
: >"$tmp/op-answer"
echo change >"$op/loose"
op_has "uncommitted changes" "?? loose"
rm "$op/loose"

git -C "$op" checkout -q main || exit 2
op_commit main-file "feat: move on"
{ git -C "$op" push -q origin main && git -C "$op" checkout -q topic; } || exit 2
op_has "commits behind" "Base: origin/main, 1 commit(s) ahead, 1 behind"
git -C "$op" push -q origin topic || exit 2
op_has "a pushed branch" "Branch: topic, pushed to origin/topic"
{ git -C "$op" branch --no-track develop origin/main && git -C "$op" push -q origin develop; } || exit 2
op_has "a named base" "Base: origin/develop, " develop

op_commit .forgejo/PULL_REQUEST_TEMPLATE.md "docs: add a template"
op_has "a template in any case" "Template: .forgejo/PULL_REQUEST_TEMPLATE.md"
op_commit docs/pull_request_template.md "docs: add another template"
op_has "several templates" "Template: several"

: >"$op/.git/MERGE_HEAD"
op_has "a merge in progress" "In progress: a merge"
rm "$op/.git/MERGE_HEAD"
git -C "$op" checkout -q --detach || exit 2
op_has "a detached HEAD" "Branch: none (detached HEAD)"
git -C "$op" checkout -q topic || exit 2

expect "$op" "open-pr context: an unknown base" 2 "base not found: nope" "$context" nope
expect "$op" "open-pr context: usage" 2 "usage: context" "$context" one two
expect "$repo" "open-pr context: no remote" 2 "no base branch found" "$context"
expect "$tmp" "open-pr context: outside a repository" 2 "not inside a git work tree" "$context"

# Scripts keep data in variables and pipes. Sandboxes refuse writes to the
# system's temporary directory, and a bare mktemp ignores TMPDIR on macOS.
if found=$(grep -l mktemp "$root"/.starling/bin/* "$root"/.starling/skills/*/scripts/* 2>/dev/null); then
	bad "scripts: no temporary files" "mktemp in: $found"
else ok; fi

# Scopes come from the repository's .starling.conf.
expect "$other" "scopes: none without a list" 1 \
	'this repository defines no scopes; drop `(api)`: `feat!: drop the v1 widget endpoints`' \
	"$check" "$msgs/valid-breaking.msg"
expect "$other" "scopes: no scope without a list" 0 "" "$check" "$msgs/valid-full.msg"
printf '[commit]\n\tscopes = server\n\tscopes = ui\n' >"$other/.starling.conf"
expect "$other" "scopes: every scopes line counts" 0 "" "$check" "$msgs/valid-note-in-body.msg"
expect "$other" "scopes: listed on separate lines" 1 "this repository allows: server, ui" \
	"$check" "$msgs/valid-breaking.msg"
printf '[commit]\n\tscopes = server ui\n\trequireScope = true\n' >"$other/.starling.conf"
expect "$other" "scopes: required" 1 "this repository requires a scope, one of: server, ui" \
	"$check" "$msgs/valid-full.msg"
expect "$other" "scopes: required and given" 0 "" "$check" "$msgs/valid-note-in-body.msg"
expect "$other" "scopes: fixups exempt when required" 0 "" "$check" "$msgs/valid-fixup.msg"
printf '[commit]\n\trequireScope = true\n' >"$other/.starling.conf"
expect "$other" "scopes: required without a list" 2 "lists no commit.scopes" "$check" "$msgs/valid-full.msg"
printf '[commit]\n\tscopes = server\n\trequireScope = maybe\n' >"$other/.starling.conf"
expect "$other" "scopes: requireScope not a boolean" 2 "must be true or false" "$check" "$msgs/valid-full.msg"
printf '[commit\n\tscopes = server\n' >"$other/.starling.conf"
expect "$other" "scopes: unreadable .starling.conf" 2 "cannot read" "$check" "$msgs/valid-full.msg"

# The commit-changes context script, in a clone whose branch has a pushed and
# a local commit.
context="$root/.starling/skills/commit-changes/scripts/context"
work=$tmp/work
{
	git init -q --bare "$tmp/origin.git" &&
		git init -q -b main "$work" &&
		git -C "$work" config user.name Test &&
		git -C "$work" config user.email test@example.com &&
		git -C "$work" commit -q --allow-empty -F "$msgs/valid-full.msg" &&
		git -C "$work" remote add origin "$tmp/origin.git" &&
		git -C "$work" push -q -u origin main 2>/dev/null &&
		git -C "$work" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main &&
		git -C "$work" checkout -q -b topic &&
		git -C "$work" commit -q --allow-empty -F "$msgs/valid-breaking.msg" &&
		git -C "$work" push -q -u origin topic 2>/dev/null &&
		git -C "$work" commit -q --allow-empty -F "$msgs/valid-url-line.msg" &&
		echo change >"$work/new-file" &&
		mkdir "$work/sub"
} || exit 2

expect "$work" "context: no scopes" 0 "Scopes: none, so headers take no scope" "$context"
expect "$work" "context: branch" 0 "Branch: topic, pushed to origin/topic" "$context"
expect "$work" "context: base" 0 "Base: origin/main, forked at" "$context"
expect "$work" "context: pushed commit" 0 " pushed feat(api)!: drop the v1 widget endpoints" "$context"
expect "$work" "context: local commit" 0 " local  docs: link the upstream issue" "$context"
expect "$work" "context: changes" 0 "?? new-file" "$context"
expect "$work/sub" "context: from a subdirectory" 0 "Branch: topic" "$context"
git -C "$work" checkout -q -b from-base --track origin/main &&
	git -C "$work" commit -q --allow-empty -F "$msgs/valid-url-line.msg" || exit 2
expect "$work" "context: tracking the base is not pushed" 0 "Branch: from-base, never pushed" "$context"
expect "$work" "context: tracking the base, local commit" 0 " local  docs: link the upstream issue" "$context"
git -C "$work" checkout -q main || exit 2
expect "$work" "context: the base branch itself" 0 "Branch: main, pushed to origin/main" "$context"
git -C "$work" checkout -q topic || exit 2
printf '[commit]\n\tscopes = api\n\tscopes = ui\n' >"$work/.starling.conf"
expect "$work" "context: scopes" 0 "Scopes: api ui" "$context"
printf '[commit]\n\tscopes = api ui\n\trequireScope = yes\n' >"$work/.starling.conf"
expect "$work" "context: required scopes" 0 "Scopes: api ui (every header needs one)" "$context"
git -C "$work" rev-parse HEAD >"$work/.git/MERGE_HEAD"
expect "$work" "context: merge in progress" 0 "In progress: a merge" "$context"
rm "$work/.git/MERGE_HEAD"
expect "$other" "context: no commits yet" 2 "cannot read .starling.conf" "$context"
rm "$other/.starling.conf"
expect "$other" "context: no commits yet" 0 "Commits: none yet" "$context"
expect "$tmp" "context: outside a repository" 2 "not inside a git work tree" "$context"

# The Claude Code hook that blocks hook bypasses. tests/deny-hook-bypass/
# NAME.cmd is a Bash command: without NAME.expect it must be allowed, with it
# blocked with that text. bash_input wraps it in Claude Code's hook input.
guard="$root/.starling/bin/deny-hook-bypass"
bash_input() {
	LC_ALL=C awk 'BEGIN { RS = "\001" } {
		s = $0; sub(/\n$/, "", s); out = ""
		for (i = 1; i <= length(s); i++) {
			c = substr(s, i, 1)
			if (c == "\\") c = "\\\\"
			else if (c == "\"") c = "\\\""
			else if (c == "\n") c = "\\n"
			else if (c == "\t") c = "\\t"
			out = out c
		}
		printf "{\"session_id\":\"test\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"%s\",\"description\":\"test\"}}", out
	}' "$1"
}
for cmd in "$root"/tests/deny-hook-bypass/*.cmd; do
	name="guard: $(basename "$cmd" .cmd)"
	out=$(bash_input "$cmd" | run "$guard" 2>&1)
	status=$?
	if [ -f "${cmd%.cmd}.expect" ]; then
		want=$(cat "${cmd%.cmd}.expect")
		if [ "$status" -eq 2 ] && printf '%s\n' "$out" | grep -qF -- "$want"; then ok; else
			bad "$name" "expected exit 2 and \"$want\", got exit $status:
$out"
		fi
	elif [ "$status" -eq 0 ] && [ -z "$out" ]; then ok; else
		bad "$name" "expected to be allowed, got exit $status:
$out"
	fi
done
out=$(printf 'not json' | run "$guard" 2>&1)
if [ $? -eq 0 ] && [ -z "$out" ]; then ok; else bad "guard: unreadable input" "expected to be allowed: $out"; fi

# Activation sets core.hooksPath, unless another tool set it.
act="$root/.starling/bin/activate-hooks"
mkdir -p "$tmp/act/.starling/hooks" && git init -q "$tmp/act" || exit 2
expect "$tmp/act" "activate: sets the hooks path" 0 "" "$act"
if [ "$(git -C "$tmp/act" config core.hooksPath)" = .starling/hooks ]; then ok; else
	bad "activate: hooks path" "core.hooksPath is '$(git -C "$tmp/act" config core.hooksPath)'"
fi
out=$(cd "$tmp/act" && run "$act" 2>&1)
if [ $? -eq 0 ] && [ -z "$out" ]; then ok; else bad "activate: quiet when active" "got: $out"; fi
git -C "$tmp/act" config core.hooksPath .husky/_
expect "$tmp/act" "activate: leaves another hooks path" 1 "core.hooksPath is
.husky/_" "$act"
if [ "$(git -C "$tmp/act" config core.hooksPath)" = .husky/_ ]; then ok; else
	bad "activate: other path unchanged" "core.hooksPath is '$(git -C "$tmp/act" config core.hooksPath)'"
fi
# The note's last line is the fix: unset the path, then activate. Run it
# with this tree's activate-hooks, since $tmp/act has only .starling/hooks.
fix=$(cd "$tmp/act" && run "$act" | tail -n 1)
want='  git config --unset core.hooksPath && .starling/bin/activate-hooks'
if [ "$fix" = "$want" ]; then ok; else bad "activate: note ends with the fix" "got: $fix"; fi
fix=$(printf '%s\n' "$fix" | sed "s|\.starling/bin/activate-hooks\$|run \"$act\"|")
out=$(cd "$tmp/act" && eval "$fix" 2>&1)
if [ $? -eq 0 ] && [ -z "$out" ] && [ "$(git -C "$tmp/act" config core.hooksPath)" = .starling/hooks ]; then ok; else
	bad "activate: the note's fix works" "status or path wrong: $out; core.hooksPath is '$(git -C "$tmp/act" config core.hooksPath)'"
fi
expect "$tmp/repo" "activate: without Starling" 2 "" "$act"

# Starling's hooks run the repository's own hooks in .githooks/.
for h in pre-commit pre-merge-commit prepare-commit-msg commit-msg post-commit \
	pre-rebase post-checkout post-merge post-rewrite pre-push; do
	if [ -x "$root/.starling/hooks/$h" ]; then ok; else bad "hooks: $h" "missing or not executable"; fi
done
fwd=$tmp/fwd
{
	git init -q "$fwd" &&
		git -C "$fwd" config user.name Test &&
		git -C "$fwd" config user.email test@example.com &&
		git -C "$fwd" config commit.gpgsign false &&
		git -C "$fwd" config core.hooksPath "$root/.starling/hooks" &&
		mkdir "$fwd/.githooks"
} || exit 2
printf '#!/bin/sh\necho "$(basename "$0") $*" >>.git/ran\n' >"$fwd/.githooks/pre-commit"
cp "$fwd/.githooks/pre-commit" "$fwd/.githooks/commit-msg"
chmod +x "$fwd/.githooks/pre-commit" "$fwd/.githooks/commit-msg"
expect "$fwd" "hooks: commit with project hooks" 0 "" git commit -q --allow-empty -F "$msgs/valid-full.msg"
if grep -q '^pre-commit' "$fwd/.git/ran" && grep -q '^commit-msg .git/COMMIT_EDITMSG' "$fwd/.git/ran"; then ok; else
	bad "hooks: project hooks ran" "$(cat "$fwd/.git/ran" 2>&1)"
fi
rm -f "$fwd/.git/ran"
expect "$fwd" "hooks: Starling's check runs first" 1 'type `chore` is not allowed' \
	git commit -q --allow-empty -F "$msgs/chore.msg"
if [ ! -s "$fwd/.git/ran" ] || ! grep -q '^commit-msg' "$fwd/.git/ran"; then ok; else
	bad "hooks: project commit-msg after a failed check" "it ran: $(cat "$fwd/.git/ran")"
fi
printf '#!/bin/sh\nexit 1\n' >"$fwd/.githooks/pre-commit"
expect "$fwd" "hooks: a failing project hook stops the commit" 1 "" \
	git commit -q --allow-empty -F "$msgs/valid-full.msg"
rm "$fwd/.githooks/pre-commit"
printf '#!/bin/sh\nexit 0\n' >"$fwd/.githooks/post-commit"
expect "$fwd" "hooks: a project hook that is not executable" 0 ".githooks/post-commit is not executable" \
	git commit -q --allow-empty -F "$msgs/valid-full.msg"

# Install and update, offline: a scratch Starling with two releases, v0.1.0
# as this checkout is, and v0.2.0 without the commit-changes skill and with
# a second workflow.
commit_all() { # DIR HEADER
	git -C "$1" add -A &&
		git -C "$1" -c core.hooksPath=/dev/null -c commit.gpgsign=false -c user.name=Test \
			-c user.email=test@example.com commit -q -m "$2" -m "Body."
}
star=$tmp/star
{
	mkdir "$star" && cp -R "$root/.starling" "$root/install" "$star"/ &&
		git init -q -b main "$star" && commit_all "$star" "feat: one" && git -C "$star" tag v0.1.0 &&
		rm -r "$star/.starling/skills/commit-changes" &&
		for forge in github forgejo; do
			cp "$star/.starling/workflows/$forge/starling-commits.yml" "$star/.starling/workflows/$forge/starling-extra.yml" || exit 2
		done &&
		commit_all "$star" "feat: two" && git -C "$star" tag v0.2.0
} || exit 2
STARLING_REPO=file://$star
export STARLING_REPO
import='This repository also follows the shared rules in Starling; read them before starting any task: @.starling/AGENTS.md'
has_jq=0
command -v jq >/dev/null 2>&1 && has_jq=1

# A target with a lone CLAUDE.md, its own Claude Code hook and master as its
# default branch.
tgt=$tmp/target
{
	git init -q -b master "$tgt" && printf '# Widgets\n\nProject rules.\n' >"$tgt/CLAUDE.md" &&
		mkdir "$tgt/.claude" &&
		printf '{"hooks": {"PreToolUse": [{"matcher": "Edit", "hooks": [{"type": "command", "command": "./lint.sh"}]}]}}\n' \
			>"$tgt/.claude/settings.json" &&
		commit_all "$tgt" "docs: start" &&
		git -C "$tgt" update-ref refs/remotes/origin/master HEAD &&
		git -C "$tgt" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/master
} || exit 2
linked() { [ "$(cd "$tgt/$1" 2>/dev/null && pwd -P)" = "$(cd "$tgt/.starling/skills/commit-changes" 2>/dev/null && pwd -P)" ]; }
gone() { [ ! -e "$1" ] && [ ! -L "$1" ]; }
real_dir() { [ -d "$1" ] && [ ! -L "$1" ]; }
assert() { # NAME CONDITION...
	name=$1
	shift
	if "$@"; then ok; else bad "$name" "failed: $*"; fi
}

expect "$tgt" "install: a release" 0 "build: install Starling v0.1.0" "$root/install" v0.1.0
if printf '%s\n' "$out" | grep -qF "The adopt-starling skill compares them"; then ok; else
	bad "install: hint at adopt-starling for a project with instructions" "$out"
fi
assert "install: version" [ "$(cat "$tgt/.starling/VERSION")" = v0.1.0 ]
assert "install: CLAUDE.md renamed" [ ! -e "$tgt/CLAUDE.md" ]
assert "install: import line after the heading" [ "$(sed -n 3p "$tgt/AGENTS.md")" = "$import" ]
assert "install: skill linked for Claude Code" linked .claude/skills/commit-changes
assert "install: skill linked for Codex" linked .agents/skills/commit-changes
assert "install: workflow on the default branch" grep -qx '      - master' "$tgt/.github/workflows/starling-commits.yml"
assert "install: hooks active" [ "$(git -C "$tgt" config core.hooksPath)" = .starling/hooks ]
if [ "$has_jq" = 1 ]; then
	assert "install: project hook kept" grep -q 'lint.sh' "$tgt/.claude/settings.json"
	assert "install: Starling's hooks merged" grep -q 'deny-hook-bypass' "$tgt/.claude/settings.json"
fi
expect "$tgt" "install: refuses a second install" 1 "already installed" "$root/install"
commit_all "$tgt" "build: install Starling v0.1.0"

expect "$tgt" "update: to the newest release" 0 "Updated Starling from v0.1.0 to v0.2.0" .starling/bin/update
if printf '%s\n' "$out" | grep -qF "adopt-starling"; then
	bad "update: no hint at adopt-starling without new skills" "$out"
else ok; fi
assert "update: version" [ "$(cat "$tgt/.starling/VERSION")" = v0.2.0 ]
assert "update: link to a removed skill removed" gone "$tgt/.claude/skills/commit-changes"
assert "update: new workflow" [ -f "$tgt/.github/workflows/starling-extra.yml" ]
assert "update: one import line" [ "$(grep -c '@\.starling/AGENTS\.md$' "$tgt/AGENTS.md")" = 1 ]
if [ "$has_jq" = 1 ]; then
	assert "update: Starling's hooks not doubled" [ "$(grep -c 'deny-hook-bypass' "$tgt/.claude/settings.json")" = 1 ]
fi
commit_all "$tgt" "build: update Starling to v0.2.0"
echo change >>"$tgt/AGENTS.md"
expect "$tgt" "update: refuses uncommitted changes" 1 "commit or stash your changes first" .starling/bin/update
git -C "$tgt" checkout -q -- AGENTS.md
expect "$tgt" "update: to an older release" 0 "from v0.2.0 to v0.1.0" .starling/bin/update v0.1.0
if printf '%s\n' "$out" | grep -qF "New skills: commit-changes. The adopt-starling skill checks"; then ok; else
	bad "update: hint at adopt-starling with the new skills" "$out"
fi
assert "update: skill linked again" linked .claude/skills/commit-changes
assert "update: removed workflow removed" [ ! -e "$tgt/.github/workflows/starling-extra.yml" ]
commit_all "$tgt" "build: update Starling to v0.1.0"
expect "$tgt" "update: from a checkout" 0 "from v0.1.0 to v0.2.0" .starling/bin/update --from "$star"
git -C "$tgt" reset -q --hard && git -C "$tgt" clean -qfd
expect "$tgt" "update: unknown release" 1 "cannot fetch Starling v9.9.9" .starling/bin/update v9.9.9
expect "$star" "update: refuses Starling's own repository" 1 "Starling's own repository" .starling/bin/update
expect "$tmp" "update: outside a repository" 1 "not inside a git work tree" "$star/.starling/bin/update"

