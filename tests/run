assert "install: no .prettierignore without Prettier" gone "$plain/.prettierignore"

# A target that uses Prettier and Renovate, with an ignore file that does not
# end in a newline and settings on one line, which jq rewrites.
fmt=$tmp/fmt
rule='{"matchFileNames": [".starling/**", ".github/workflows/starling-*.yml"], "enabled": false}'
{
	git init -q "$fmt" && printf '{"devDependencies": {"prettier": "3.9.10"}}\n' >"$fmt/package.json" &&
		printf '{\n  extends: ["config:recommended"],\n}\n' >"$fmt/renovate.json5" &&
		printf 'dist/' >"$fmt/.prettierignore" && mkdir "$fmt/.claude" &&
		echo '{"model": "opus"}' >"$fmt/.claude/settings.json" && commit_all "$fmt" "docs: start"
} || exit 2
expect "$fmt" "install: with Prettier" 0 "M .prettierignore" "$root/install"
assert "install: Prettier ignores .starling/" [ "$(cat "$fmt/.prettierignore")" = "dist/

# Starling's files are managed by Starling and replaced on every update.
.starling/" ]
if [ "$has_jq" = 1 ]; then
	if printf '%s\n' "$out" | grep -qF "run Prettier on it"; then ok; else
		bad "install: note on the settings jq rewrote" "$out"
	fi
fi
commit_all "$fmt" "build: install Starling v0.2.0"
expect "$fmt" "update: with Prettier" 0 "Reinstalled Starling v0.2.0" .starling/bin/update
assert "update: .starling/ ignored once" [ "$(grep -c '^\.starling/$' "$fmt/.prettierignore")" = 1 ]
if printf '%s\n' "$out" | grep -qF "run Prettier on it"; then
	bad "update: no settings note when jq changes nothing" "$out"
else ok; fi
if printf '%s\n' "$out" | grep -qF "  $rule"; then ok; else bad "update: the Renovate rule" "$out"; fi
printf '{\n  extends: ["config:recommended"],\n  packageRules: [%s],\n}\n' "$rule" >"$fmt/renovate.json5"
commit_all "$fmt" "build: keep Renovate off Starling's files"
expect "$fmt" "update: with the Renovate rule" 0 "Reinstalled Starling v0.2.0" .starling/bin/update
if printf '%s\n' "$out" | grep -qF "Renovate"; then bad "update: no Renovate note once the rule exists" "$out"; else ok; fi

# A target where husky owns the hooks, AGENTS.md has no heading, a project
# skill has Starling's skill name and jq is missing.
husky=$tmp/husky
{
	git init -q "$husky" && printf 'Project rules.\n' >"$husky/AGENTS.md" &&
		mkdir -p "$husky/.claude/skills/commit-changes" &&
		echo '{"model": "opus"}' >"$husky/.claude/settings.json" &&
		echo "# Own skill" >"$husky/.claude/skills/commit-changes/SKILL.md" &&
		commit_all "$husky" "docs: start" && git -C "$husky" config core.hooksPath .husky/_
} || exit 2
STARLING_JQ=$tmp/no-jq
export STARLING_JQ
out=$(cd "$husky" && run "$root/install" v0.1.0 2>&1)
status=$?
unset STARLING_JQ
assert "install: despite husky" [ "$status" -eq 0 ]
for want in "core.hooksPath is" "belongs to the project" "by hand"; do
	if printf '%s\n' "$out" | grep -qF -- "$want"; then ok; else
		bad "install: note \"$want\"" "$out"
	fi
done
assert "install: import line first without a heading" [ "$(sed -n 1p "$husky/AGENTS.md")" = "$import" ]
assert "install: project skill untouched" real_dir "$husky/.claude/skills/commit-changes"
assert "install: hooks path left to husky" [ "$(git -C "$husky" config core.hooksPath)" = .husky/_ ]
assert "install: settings untouched without jq" [ "$(cat "$husky/.claude/settings.json")" = '{"model": "opus"}' ]
unset STARLING_REPO

# Ranges, checked as CI checks them.
git -C "$repo" commit -q --allow-empty -F "$msgs/valid-full.msg" || exit 2
git -C "$repo" commit -q --allow-empty -F "$msgs/valid-breaking.msg" || exit 2
base=$(git -C "$repo" rev-list --max-parents=0 HEAD)

expect "$repo" "range: clean range passes" 0 "" "$check" --range "$base..HEAD"
expect "$repo" "range: unreadable range fails" 2 "cannot read the commit range" "$check" --range "nope..HEAD"
git -C "$repo" commit -q --allow-empty -F "$msgs/valid-fixup.msg"
expect "$repo" "range: fixup passes by default" 0 "" "$check" --range "$base..HEAD"
expect "$repo" "range: fixup fails with --reject-fixups" 1 "git rebase -i --autosquash" \
	"$check" --range "$base..HEAD" --reject-fixups
git -C "$repo" commit -q --allow-empty -F "$msgs/chore.msg"
expect "$repo" "range: bad message fails and names the commit" 1 "chore(deps): update vite" \
	"$check" --range "$base..HEAD"
expect "$repo" "range: failure points to the skill" 1 "commit-changes skill" "$check" --range "$base..HEAD"
git -C "$repo" reset -q --hard HEAD~2
git -C "$repo" checkout -q -b side
git -C "$repo" commit -q --allow-empty -F "$msgs/valid-url-line.msg"
git -C "$repo" checkout -q main
git -C "$repo" merge -q --no-ff --no-edit side
expect "$repo" "range: merge passes by default" 0 "" "$check" --range "$base..HEAD"
expect "$repo" "range: merge fails with --reject-merges" 1 "Merge commits are not allowed" \
	"$check" --range "$base..HEAD" --reject-merges

echo "$passed passed, $failed failed"
[ "$failed" -eq 0 ]
