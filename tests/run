if printf '%s\n' "$out" | grep -q '^  commit-changes: .*agents/policy'; then
	bad "survey: no policy line for a skill that reads none" "$out"
else ok; fi

# $tgt is at v0.1.0, committed as an update from v0.2.0, which had no
