	if printf '%s\n' "$out" | grep -qF -- "$2"; then ok; else bad "survey: $1" "expected \"$2\" in:
$out"; fi
}
expect "$husky" "survey: a first install" 0 "Starling: v0.1.0, a first install, not committed yet" "$survey"
surveyed "every skill is new" "New skills: all of Starling's"
surveyed "a project skill" "  commit-changes (.claude/skills/commit-changes): (no description)"
