#!/bin/sh
# Run Starling's tests. Needs only POSIX sh and git.
#
# tests/commit-msg/NAME.msg is a commit message. Without NAME.expect it must
# pass; with NAME.expect it must fail with output containing that file's text.
# Messages are checked in a scratch repository whose .starling.conf allows the
# scopes api, deps, server and ui.
#
# TEST_SH runs the scripts under test with a given shell, e.g. TEST_SH=dash.
# Without it, they run with their own #! line.

set -u
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
check="$root/.starling/bin/check-commit-msg"
hook="$root/.starling/hooks/commit-msg"
msgs="$root/tests/commit-msg"
passed=0
failed=0

ok() { passed=$((passed + 1)); }
bad() { failed=$((failed + 1)); printf 'FAIL %s\n%s\n\n' "$1" "$2"; }
run() { if [ -f "$1" ]; then ${TEST_SH:+$TEST_SH} "$@"; else "$@"; fi; }

# Scratch repositories: $repo allows scopes, $other starts without a list.
tmp=$(mktemp -d) || exit 2
trap 'rm -rf "$tmp"' EXIT
repo=$tmp/repo
other=$tmp/other
for dir in "$repo" "$other"; do
	git init -q -b main "$dir" &&
		git -C "$dir" config user.name Test &&
		git -C "$dir" config user.email test@example.com || exit 2
done
printf '[commit]\n\tscopes = api deps server ui\n' >"$repo/.starling.conf"

# expect DIR NAME WANT_STATUS WANT_TEXT COMMAND ARGS...: run the command in DIR.
expect() {
	dir=$1 name=$2 want_status=$3 want=$4
	shift 4
	out=$(cd "$dir" && run "$@" 2>&1)
	status=$?
	if [ "$status" -eq "$want_status" ] && { [ -z "$want" ] || printf '%s\n' "$out" | grep -qF -- "$want"; }; then ok; else
		bad "$name" "expected exit $want_status and \"$want\", got exit $status:
$out"
	fi
}

# Messages, checked as the commit-msg hook checks them.
for msg in "$msgs"/*.msg; do
	name=$(basename "$msg" .msg)
	if [ -f "${msg%.msg}.expect" ]; then
		expect "$repo" "$name" 1 "$(cat "${msg%.msg}.expect")" "$check" "$msg"
	else
		expect "$repo" "$name" 0 "" "$check" "$msg"
	fi
done

# The hook passes the message file on to the checker.
expect "$repo" "hook: valid message" 0 "" "$hook" "$msgs/valid-full.msg"
expect "$repo" "hook: invalid message" 1 'type `chore` is not allowed' "$hook" "$msgs/chore.msg"

# Usage errors.
expect "$repo" "usage: no arguments" 2 "usage:" "$check"

# Every .starling/ path that Starling's instructions name exists.
missing=$(find "$root/.starling" -name '*.md' | while read -r md; do
	awk '{
		s = $0
		while (match(s, /`\.starling\/[^` "]*/)) {
			print substr(s, RSTART + 1, RLENGTH - 1)
			s = substr(s, RSTART + RLENGTH)
		}
	}' "$md" | while read -r path; do
		[ -e "$root/$path" ] || echo "${md#"$root"/} names $path"
	done
done)
if [ -z "$missing" ]; then ok; else bad "instructions: named paths exist" "$missing"; fi

# Claude Code resolves an @ import only where the path ends the line or is
# followed by a space: in "@.starling/AGENTS.md." the period becomes part of
# the path.
if grep -q ' @\.starling/AGENTS\.md$' "$root/AGENTS.md"; then ok; else
	bad "instructions: import line" "AGENTS.md needs a line ending in ' @.starling/AGENTS.md'"
fi

# Starling uses its own Claude Code settings, as the installer writes them.
if cmp -s "$root/.claude/settings.json" "$root/.starling/claude-settings.json"; then ok; else
	bad "settings: .claude/settings.json" "differs from .starling/claude-settings.json"
fi

# Starling checks its own commits with the workflow the installer installs.
if cmp -s "$root/.github/workflows/starling-commits.yml" "$root/.starling/workflows/starling-commits.yml"; then ok; else
	bad "workflow: .github/workflows/starling-commits.yml" "differs from .starling/workflows/starling-commits.yml"
fi

# Starling uses its own skills, linked as the installer links them.
for skill in "$root"/.starling/skills/*/; do
	name=$(basename "$skill")
	for dir in .claude/skills .agents/skills; do
		if [ "$(cd "$root/$dir/$name" 2>/dev/null && pwd -P)" = "$(cd "$skill" && pwd -P)" ]; then ok; else
			bad "skills: $dir/$name" "expected a link to ../../.starling/skills/$name"
		fi
	done
done

# test-skill's lint. tests/skills/NAME is a skill: without NAME.expect the
# lint must pass it silently; with NAME.expect it must fail and print every
# line of that file. Starling's own skills must pass.
lint="$root/.starling/skills/test-skill/scripts/lint"
for skill in "$root"/tests/skills/*/; do
	name=$(basename "$skill")
	out=$(cd "$root" && run "$lint" "$skill" 2>&1)
	status=$?
	if [ -f "$root/tests/skills/$name.expect" ]; then
		missing=
		while IFS= read -r want; do
			printf '%s\n' "$out" | grep -qF -- "$want" || missing="$missing  $want
"
		done <"$root/tests/skills/$name.expect"
		if [ "$status" -eq 1 ] && [ -z "$missing" ]; then ok; else
			bad "lint: $name" "exit $status; missing:
$missing
got:
$out"
		fi
	elif [ "$status" -eq 0 ] && [ -z "$out" ]; then ok; else
		bad "lint: $name" "expected no findings, got exit $status:
$out"
	fi
done
expect "$root" "lint: Starling's own skills" 0 "" "$lint"
if [ -z "$out" ]; then ok; else bad "lint: Starling's own skills are silent" "$out"; fi
long=$tmp/skills/review-long
{
	mkdir -p "$long" "$tmp/skills/notes" && cp "$root/tests/skills/review-widgets/SKILL.md" "$long/SKILL.md" &&
		awk 'BEGIN { for (i = 0; i < 500; i++) print "Line." }' >>"$long/SKILL.md" &&
		sed 's/review-widgets/review-long/' "$long/SKILL.md" >"$long/SKILL.md.new" && mv "$long/SKILL.md.new" "$long/SKILL.md" &&
		mkdir -p "$long/scripts" "$long/references" && cp -p "$root/tests/skills/review-widgets/scripts/"* "$long/scripts/" &&
		cp "$root/tests/skills/review-widgets/references/"* "$long/references/"
} || exit 2
expect "$root" "lint: a long SKILL.md" 1 "keep it under 500" "$lint" "$long"
expect "$root" "lint: a directory of skills" 1 "notes: has no SKILL.md" "$lint" "$tmp/skills"
expect "$root" "lint: neither skill nor directory" 2 "neither a skill nor a directory of skills" "$lint" "$tmp/none"
expect "$tmp" "lint: outside a repository" 2 "not inside a git work tree" "$lint"
expect "$root" "lint: options" 2 "usage: lint" "$lint" --help

# In a project, the lint checks the project's own skills: real directories in
# .agents/skills and .claude/skills, not Starling's or links.
proj=$tmp/proj
{
	git init -q "$proj" && mkdir -p "$proj/.agents/skills" "$proj/.claude/skills" "$proj/.starling/skills" &&
		cp -R "$root/tests/skills/fetch-widgets" "$proj/.agents/skills/" &&
		ln -s ../../.agents/skills/fetch-widgets "$proj/.claude/skills/fetch-widgets" &&
		cp -R "$root/tests/skills/review-mismatch" "$proj/.starling/skills/" &&
		echo v0.0.0 >"$proj/.starling/VERSION"
} || exit 2
expect "$proj" "lint: a project's own skills" 1 ".agents/skills/fetch-widgets/SKILL.md:2:" "$lint"
if printf '%s\n' "$out" | grep -q 'review-mismatch\|\.claude/skills'; then
	bad "lint: not Starling's skills or links in a project" "$out"
else ok; fi

# Scripts keep data in variables and pipes. Sandboxes refuse writes to the
# system's temporary directory, and a bare mktemp ignores TMPDIR on macOS.
if found=$(grep -l mktemp "$root"/.starling/bin/* "$root"/.starling/skills/*/scripts/* 2>/dev/null); then
	bad "scripts: no temporary files" "mktemp in: $found"
else ok; fi

# Scopes come from the repository's .starling.conf.
expect "$other" "scopes: none without a list" 1 \
	'this repository defines no scopes; drop `(api)`: `feat!: drop the v1 widget endpoints`' \
	"$check" "$msgs/valid-breaking.msg"
expect "$other" "scopes: no scope without a list" 0 "" "$check" "$msgs/valid-full.msg"
printf '[commit]\n\tscopes = server\n\tscopes = ui\n' >"$other/.starling.conf"
expect "$other" "scopes: every scopes line counts" 0 "" "$check" "$msgs/valid-note-in-body.msg"
expect "$other" "scopes: listed on separate lines" 1 "this repository allows: server, ui" \
	"$check" "$msgs/valid-breaking.msg"
printf '[commit]\n\tscopes = server ui\n\trequireScope = true\n' >"$other/.starling.conf"
expect "$other" "scopes: required" 1 "this repository requires a scope, one of: server, ui" \
	"$check" "$msgs/valid-full.msg"
expect "$other" "scopes: required and given" 0 "" "$check" "$msgs/valid-note-in-body.msg"
expect "$other" "scopes: fixups exempt when required" 0 "" "$check" "$msgs/valid-fixup.msg"
printf '[commit]\n\trequireScope = true\n' >"$other/.starling.conf"
expect "$other" "scopes: required without a list" 2 "lists no commit.scopes" "$check" "$msgs/valid-full.msg"
printf '[commit]\n\tscopes = server\n\trequireScope = maybe\n' >"$other/.starling.conf"
expect "$other" "scopes: requireScope not a boolean" 2 "must be true or false" "$check" "$msgs/valid-full.msg"
printf '[commit\n\tscopes = server\n' >"$other/.starling.conf"
expect "$other" "scopes: unreadable .starling.conf" 2 "cannot read" "$check" "$msgs/valid-full.msg"

# The commit-changes context script, in a clone whose branch has a pushed and
# a local commit.
context="$root/.starling/skills/commit-changes/scripts/context"
work=$tmp/work
{
	git init -q --bare "$tmp/origin.git" &&
		git init -q -b main "$work" &&
		git -C "$work" config user.name Test &&
		git -C "$work" config user.email test@example.com &&
		git -C "$work" commit -q --allow-empty -F "$msgs/valid-full.msg" &&
		git -C "$work" remote add origin "$tmp/origin.git" &&
		git -C "$work" push -q -u origin main 2>/dev/null &&
		git -C "$work" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main &&
		git -C "$work" checkout -q -b topic &&
		git -C "$work" commit -q --allow-empty -F "$msgs/valid-breaking.msg" &&
		git -C "$work" push -q -u origin topic 2>/dev/null &&
		git -C "$work" commit -q --allow-empty -F "$msgs/valid-url-line.msg" &&
		echo change >"$work/new-file" &&
		mkdir "$work/sub"
} || exit 2

expect "$work" "context: no scopes" 0 "Scopes: none, so headers take no scope" "$context"
expect "$work" "context: branch" 0 "Branch: topic, pushed to origin/topic" "$context"
expect "$work" "context: base" 0 "Base: origin/main, forked at" "$context"
expect "$work" "context: pushed commit" 0 " pushed feat(api)!: drop the v1 widget endpoints" "$context"
expect "$work" "context: local commit" 0 " local  docs: link the upstream issue" "$context"
expect "$work" "context: changes" 0 "?? new-file" "$context"
expect "$work/sub" "context: from a subdirectory" 0 "Branch: topic" "$context"
git -C "$work" checkout -q -b from-base --track origin/main &&
	git -C "$work" commit -q --allow-empty -F "$msgs/valid-url-line.msg" || exit 2
expect "$work" "context: tracking the base is not pushed" 0 "Branch: from-base, never pushed" "$context"
expect "$work" "context: tracking the base, local commit" 0 " local  docs: link the upstream issue" "$context"
git -C "$work" checkout -q main || exit 2
expect "$work" "context: the base branch itself" 0 "Branch: main, pushed to origin/main" "$context"
git -C "$work" checkout -q topic || exit 2
printf '[commit]\n\tscopes = api\n\tscopes = ui\n' >"$work/.starling.conf"
expect "$work" "context: scopes" 0 "Scopes: api ui" "$context"
printf '[commit]\n\tscopes = api ui\n\trequireScope = yes\n' >"$work/.starling.conf"
expect "$work" "context: required scopes" 0 "Scopes: api ui (every header needs one)" "$context"
git -C "$work" rev-parse HEAD >"$work/.git/MERGE_HEAD"
expect "$work" "context: merge in progress" 0 "In progress: a merge" "$context"
rm "$work/.git/MERGE_HEAD"
expect "$other" "context: no commits yet" 2 "cannot read .starling.conf" "$context"
rm "$other/.starling.conf"
expect "$other" "context: no commits yet" 0 "Commits: none yet" "$context"
expect "$tmp" "context: outside a repository" 2 "not inside a git work tree" "$context"

# The Claude Code hook that blocks hook bypasses. tests/deny-hook-bypass/
# NAME.cmd is a Bash command: without NAME.expect it must be allowed, with it
# blocked with that text. bash_input wraps it in Claude Code's hook input.
guard="$root/.starling/bin/deny-hook-bypass"
bash_input() {
	LC_ALL=C awk 'BEGIN { RS = "\001" } {
		s = $0; sub(/\n$/, "", s); out = ""
		for (i = 1; i <= length(s); i++) {
			c = substr(s, i, 1)
			if (c == "\\") c = "\\\\"
			else if (c == "\"") c = "\\\""
			else if (c == "\n") c = "\\n"
			else if (c == "\t") c = "\\t"
			out = out c
		}
		printf "{\"session_id\":\"test\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"%s\",\"description\":\"test\"}}", out
	}' "$1"
}
for cmd in "$root"/tests/deny-hook-bypass/*.cmd; do
	name="guard: $(basename "$cmd" .cmd)"
	out=$(bash_input "$cmd" | run "$guard" 2>&1)
	status=$?
	if [ -f "${cmd%.cmd}.expect" ]; then
		want=$(cat "${cmd%.cmd}.expect")
		if [ "$status" -eq 2 ] && printf '%s\n' "$out" | grep -qF -- "$want"; then ok; else
			bad "$name" "expected exit 2 and \"$want\", got exit $status:
$out"
		fi
	elif [ "$status" -eq 0 ] && [ -z "$out" ]; then ok; else
		bad "$name" "expected to be allowed, got exit $status:
$out"
	fi
done
out=$(printf 'not json' | run "$guard" 2>&1)
if [ $? -eq 0 ] && [ -z "$out" ]; then ok; else bad "guard: unreadable input" "expected to be allowed: $out"; fi

# Activation sets core.hooksPath, unless another tool set it.
act="$root/.starling/bin/activate-hooks"
mkdir -p "$tmp/act/.starling/hooks" && git init -q "$tmp/act" || exit 2
expect "$tmp/act" "activate: sets the hooks path" 0 "" "$act"
if [ "$(git -C "$tmp/act" config core.hooksPath)" = .starling/hooks ]; then ok; else
	bad "activate: hooks path" "core.hooksPath is '$(git -C "$tmp/act" config core.hooksPath)'"
fi
out=$(cd "$tmp/act" && run "$act" 2>&1)
if [ $? -eq 0 ] && [ -z "$out" ]; then ok; else bad "activate: quiet when active" "got: $out"; fi
git -C "$tmp/act" config core.hooksPath .husky/_
expect "$tmp/act" "activate: leaves another hooks path" 1 "core.hooksPath is
.husky/_" "$act"
if [ "$(git -C "$tmp/act" config core.hooksPath)" = .husky/_ ]; then ok; else
	bad "activate: other path unchanged" "core.hooksPath is '$(git -C "$tmp/act" config core.hooksPath)'"
fi
# The note's last line is the fix: unset the path, then activate. Run it
# with this tree's activate-hooks, since $tmp/act has only .starling/hooks.
fix=$(cd "$tmp/act" && run "$act" | tail -n 1)
want='  git config --unset core.hooksPath && .starling/bin/activate-hooks'
if [ "$fix" = "$want" ]; then ok; else bad "activate: note ends with the fix" "got: $fix"; fi
fix=$(printf '%s\n' "$fix" | sed "s|\.starling/bin/activate-hooks\$|run \"$act\"|")
out=$(cd "$tmp/act" && eval "$fix" 2>&1)
if [ $? -eq 0 ] && [ -z "$out" ] && [ "$(git -C "$tmp/act" config core.hooksPath)" = .starling/hooks ]; then ok; else
	bad "activate: the note's fix works" "status or path wrong: $out; core.hooksPath is '$(git -C "$tmp/act" config core.hooksPath)'"
fi
expect "$tmp/repo" "activate: without Starling" 2 "" "$act"

# Starling's hooks run the repository's own hooks in .githooks/.
for h in pre-commit pre-merge-commit prepare-commit-msg commit-msg post-commit \
	pre-rebase post-checkout post-merge post-rewrite pre-push; do
	if [ -x "$root/.starling/hooks/$h" ]; then ok; else bad "hooks: $h" "missing or not executable"; fi
done
fwd=$tmp/fwd
{
	git init -q "$fwd" &&
		git -C "$fwd" config user.name Test &&
		git -C "$fwd" config user.email test@example.com &&
		git -C "$fwd" config commit.gpgsign false &&
		git -C "$fwd" config core.hooksPath "$root/.starling/hooks" &&
		mkdir "$fwd/.githooks"
} || exit 2
printf '#!/bin/sh\necho "$(basename "$0") $*" >>.git/ran\n' >"$fwd/.githooks/pre-commit"
cp "$fwd/.githooks/pre-commit" "$fwd/.githooks/commit-msg"
chmod +x "$fwd/.githooks/pre-commit" "$fwd/.githooks/commit-msg"
expect "$fwd" "hooks: commit with project hooks" 0 "" git commit -q --allow-empty -F "$msgs/valid-full.msg"
if grep -q '^pre-commit' "$fwd/.git/ran" && grep -q '^commit-msg .git/COMMIT_EDITMSG' "$fwd/.git/ran"; then ok; else
	bad "hooks: project hooks ran" "$(cat "$fwd/.git/ran" 2>&1)"
fi
rm -f "$fwd/.git/ran"
expect "$fwd" "hooks: Starling's check runs first" 1 'type `chore` is not allowed' \
	git commit -q --allow-empty -F "$msgs/chore.msg"
if [ ! -s "$fwd/.git/ran" ] || ! grep -q '^commit-msg' "$fwd/.git/ran"; then ok; else
	bad "hooks: project commit-msg after a failed check" "it ran: $(cat "$fwd/.git/ran")"
fi
printf '#!/bin/sh\nexit 1\n' >"$fwd/.githooks/pre-commit"
expect "$fwd" "hooks: a failing project hook stops the commit" 1 "" \
	git commit -q --allow-empty -F "$msgs/valid-full.msg"
rm "$fwd/.githooks/pre-commit"
printf '#!/bin/sh\nexit 0\n' >"$fwd/.githooks/post-commit"
expect "$fwd" "hooks: a project hook that is not executable" 0 ".githooks/post-commit is not executable" \
	git commit -q --allow-empty -F "$msgs/valid-full.msg"

# Install and update, offline: a scratch Starling with two releases, v0.1.0
# as this checkout is, and v0.2.0 without the commit-changes skill and with
# a second workflow.
commit_all() { # DIR HEADER
	git -C "$1" add -A &&
		git -C "$1" -c core.hooksPath=/dev/null -c commit.gpgsign=false -c user.name=Test \
			-c user.email=test@example.com commit -q -m "$2" -m "Body."
}
star=$tmp/star
{
	mkdir "$star" && cp -R "$root/.starling" "$root/install" "$star"/ &&
		git init -q -b main "$star" && commit_all "$star" "feat: one" && git -C "$star" tag v0.1.0 &&
		rm -r "$star/.starling/skills/commit-changes" &&
		cp "$star/.starling/workflows/starling-commits.yml" "$star/.starling/workflows/starling-extra.yml" &&
		commit_all "$star" "feat: two" && git -C "$star" tag v0.2.0
} || exit 2
STARLING_REPO=file://$star
export STARLING_REPO
import='This repository also follows the shared rules in Starling; read them before starting any task: @.starling/AGENTS.md'
has_jq=0
command -v jq >/dev/null 2>&1 && has_jq=1

# A target with a lone CLAUDE.md, its own Claude Code hook and master as its
# default branch.
tgt=$tmp/target
{
	git init -q -b master "$tgt" && printf '# Widgets\n\nProject rules.\n' >"$tgt/CLAUDE.md" &&
		mkdir "$tgt/.claude" &&
		printf '{"hooks": {"PreToolUse": [{"matcher": "Edit", "hooks": [{"type": "command", "command": "./lint.sh"}]}]}}\n' \
			>"$tgt/.claude/settings.json" &&
		commit_all "$tgt" "docs: start" &&
		git -C "$tgt" update-ref refs/remotes/origin/master HEAD &&
		git -C "$tgt" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/master
} || exit 2
linked() { [ "$(cd "$tgt/$1" 2>/dev/null && pwd -P)" = "$(cd "$tgt/.starling/skills/commit-changes" 2>/dev/null && pwd -P)" ]; }
gone() { [ ! -e "$1" ] && [ ! -L "$1" ]; }
real_dir() { [ -d "$1" ] && [ ! -L "$1" ]; }
assert() { # NAME CONDITION...
	name=$1
	shift
	if "$@"; then ok; else bad "$name" "failed: $*"; fi
}

expect "$tgt" "install: a release" 0 "build: install Starling v0.1.0" "$root/install" v0.1.0
assert "install: version" [ "$(cat "$tgt/.starling/VERSION")" = v0.1.0 ]
assert "install: CLAUDE.md renamed" [ ! -e "$tgt/CLAUDE.md" ]
assert "install: import line after the heading" [ "$(sed -n 3p "$tgt/AGENTS.md")" = "$import" ]
assert "install: skill linked for Claude Code" linked .claude/skills/commit-changes
assert "install: skill linked for Codex" linked .agents/skills/commit-changes
assert "install: workflow on the default branch" grep -qx '      - master' "$tgt/.github/workflows/starling-commits.yml"
assert "install: hooks active" [ "$(git -C "$tgt" config core.hooksPath)" = .starling/hooks ]
if [ "$has_jq" = 1 ]; then
	assert "install: project hook kept" grep -q 'lint.sh' "$tgt/.claude/settings.json"
	assert "install: Starling's hooks merged" grep -q 'deny-hook-bypass' "$tgt/.claude/settings.json"
fi
expect "$tgt" "install: refuses a second install" 1 "already installed" "$root/install"
commit_all "$tgt" "build: install Starling v0.1.0"

expect "$tgt" "update: to the newest release" 0 "Updated Starling from v0.1.0 to v0.2.0" .starling/bin/update
assert "update: version" [ "$(cat "$tgt/.starling/VERSION")" = v0.2.0 ]
assert "update: link to a removed skill removed" gone "$tgt/.claude/skills/commit-changes"
assert "update: new workflow" [ -f "$tgt/.github/workflows/starling-extra.yml" ]
assert "update: one import line" [ "$(grep -c '@\.starling/AGENTS\.md$' "$tgt/AGENTS.md")" = 1 ]
if [ "$has_jq" = 1 ]; then
	assert "update: Starling's hooks not doubled" [ "$(grep -c 'deny-hook-bypass' "$tgt/.claude/settings.json")" = 1 ]
fi
commit_all "$tgt" "build: update Starling to v0.2.0"
echo change >>"$tgt/AGENTS.md"
expect "$tgt" "update: refuses uncommitted changes" 1 "commit or stash your changes first" .starling/bin/update
git -C "$tgt" checkout -q -- AGENTS.md
expect "$tgt" "update: to an older release" 0 "from v0.2.0 to v0.1.0" .starling/bin/update v0.1.0
assert "update: skill linked again" linked .claude/skills/commit-changes
assert "update: removed workflow removed" [ ! -e "$tgt/.github/workflows/starling-extra.yml" ]
commit_all "$tgt" "build: update Starling to v0.1.0"
expect "$tgt" "update: from a checkout" 0 "from v0.1.0 to v0.2.0" .starling/bin/update --from "$star"
git -C "$tgt" reset -q --hard && git -C "$tgt" clean -qfd
expect "$tgt" "update: unknown release" 1 "cannot fetch Starling v9.9.9" .starling/bin/update v9.9.9
expect "$star" "update: refuses Starling's own repository" 1 "Starling's own repository" .starling/bin/update
expect "$tmp" "update: outside a repository" 1 "not inside a git work tree" "$star/.starling/bin/update"

# A target without instructions or settings.
plain=$tmp/plain
{ git init -q "$plain" && echo "readme" >"$plain/README" && commit_all "$plain" "docs: start"; } || exit 2
expect "$plain" "install: into a bare project" 0 "Installed Starling v0.2.0" "$root/install"
assert "install: AGENTS.md created" [ "$(cat "$plain/AGENTS.md")" = "# plain

$import" ]
assert "install: settings created" cmp -s "$plain/.claude/settings.json" "$plain/.starling/claude-settings.json"
assert "install: no .prettierignore without Prettier" gone "$plain/.prettierignore"

# A target that uses Prettier and Renovate, with an ignore file that does not
# end in a newline and settings on one line, which jq rewrites.
fmt=$tmp/fmt
rule='{"matchFileNames": [".starling/**", ".github/workflows/starling-*.yml"], "enabled": false}'
{
	git init -q "$fmt" && printf '{"devDependencies": {"prettier": "3.9.10"}}\n' >"$fmt/package.json" &&
		printf '{\n  extends: ["config:recommended"],\n}\n' >"$fmt/renovate.json5" &&
		printf 'dist/' >"$fmt/.prettierignore" && mkdir "$fmt/.claude" &&
		echo '{"model": "opus"}' >"$fmt/.claude/settings.json" && commit_all "$fmt" "docs: start"
} || exit 2
expect "$fmt" "install: with Prettier" 0 "M .prettierignore" "$root/install"
assert "install: Prettier ignores .starling/" [ "$(cat "$fmt/.prettierignore")" = "dist/

# Starling's files are managed by Starling and replaced on every update.
.starling/" ]
if [ "$has_jq" = 1 ]; then
	if printf '%s\n' "$out" | grep -qF "run Prettier on it"; then ok; else
		bad "install: note on the settings jq rewrote" "$out"
	fi
fi
commit_all "$fmt" "build: install Starling v0.2.0"
expect "$fmt" "update: with Prettier" 0 "Reinstalled Starling v0.2.0" .starling/bin/update
assert "update: .starling/ ignored once" [ "$(grep -c '^\.starling/$' "$fmt/.prettierignore")" = 1 ]
if printf '%s\n' "$out" | grep -qF "run Prettier on it"; then
	bad "update: no settings note when jq changes nothing" "$out"
else ok; fi
if printf '%s\n' "$out" | grep -qF "  $rule"; then ok; else bad "update: the Renovate rule" "$out"; fi
printf '{\n  extends: ["config:recommended"],\n  packageRules: [%s],\n}\n' "$rule" >"$fmt/renovate.json5"
commit_all "$fmt" "build: keep Renovate off Starling's files"
expect "$fmt" "update: with the Renovate rule" 0 "Reinstalled Starling v0.2.0" .starling/bin/update
if printf '%s\n' "$out" | grep -qF "Renovate"; then bad "update: no Renovate note once the rule exists" "$out"; else ok; fi

# A target where husky owns the hooks, AGENTS.md has no heading, a project
# skill has Starling's skill name and jq is missing.
husky=$tmp/husky
{
	git init -q "$husky" && printf 'Project rules.\n' >"$husky/AGENTS.md" &&
		mkdir -p "$husky/.claude/skills/commit-changes" &&
		echo '{"model": "opus"}' >"$husky/.claude/settings.json" &&
		echo "# Own skill" >"$husky/.claude/skills/commit-changes/SKILL.md" &&
		commit_all "$husky" "docs: start" && git -C "$husky" config core.hooksPath .husky/_
} || exit 2
STARLING_JQ=$tmp/no-jq
export STARLING_JQ
out=$(cd "$husky" && run "$root/install" v0.1.0 2>&1)
status=$?
unset STARLING_JQ
assert "install: despite husky" [ "$status" -eq 0 ]
for want in "core.hooksPath is" "belongs to the project" "by hand"; do
	if printf '%s\n' "$out" | grep -qF -- "$want"; then ok; else
		bad "install: note \"$want\"" "$out"
	fi
done
assert "install: import line first without a heading" [ "$(sed -n 1p "$husky/AGENTS.md")" = "$import" ]
assert "install: project skill untouched" real_dir "$husky/.claude/skills/commit-changes"
assert "install: hooks path left to husky" [ "$(git -C "$husky" config core.hooksPath)" = .husky/_ ]
assert "install: settings untouched without jq" [ "$(cat "$husky/.claude/settings.json")" = '{"model": "opus"}' ]
unset STARLING_REPO

# Ranges, checked as CI checks them.
git -C "$repo" commit -q --allow-empty -F "$msgs/valid-full.msg" || exit 2
git -C "$repo" commit -q --allow-empty -F "$msgs/valid-breaking.msg" || exit 2
base=$(git -C "$repo" rev-list --max-parents=0 HEAD)

expect "$repo" "range: clean range passes" 0 "" "$check" --range "$base..HEAD"
expect "$repo" "range: unreadable range fails" 2 "cannot read the commit range" "$check" --range "nope..HEAD"
git -C "$repo" commit -q --allow-empty -F "$msgs/valid-fixup.msg"
expect "$repo" "range: fixup passes by default" 0 "" "$check" --range "$base..HEAD"
expect "$repo" "range: fixup fails with --reject-fixups" 1 "git rebase -i --autosquash" \
	"$check" --range "$base..HEAD" --reject-fixups
git -C "$repo" commit -q --allow-empty -F "$msgs/chore.msg"
expect "$repo" "range: bad message fails and names the commit" 1 "chore(deps): update vite" \
	"$check" --range "$base..HEAD"
expect "$repo" "range: failure points to the skill" 1 "commit-changes skill" "$check" --range "$base..HEAD"
git -C "$repo" reset -q --hard HEAD~2
git -C "$repo" checkout -q -b side
git -C "$repo" commit -q --allow-empty -F "$msgs/valid-url-line.msg"
git -C "$repo" checkout -q main
git -C "$repo" merge -q --no-ff --no-edit side
expect "$repo" "range: merge passes by default" 0 "" "$check" --range "$base..HEAD"
expect "$repo" "range: merge fails with --reject-merges" 1 "Merge commits are not allowed" \
	"$check" --range "$base..HEAD" --reject-merges

echo "$passed passed, $failed failed"
[ "$failed" -eq 0 ]
