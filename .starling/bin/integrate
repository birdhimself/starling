#!/bin/sh
# Starling: put a Starling source into this repository.
#
#   integrate SOURCE VERSION
#
# Internal: install and update run it from the version being installed, so
# every update uses the new version's integration. SOURCE is a Starling
# checkout. In the repository around the current directory, it:
#   - replaces .starling/ with SOURCE/.starling and writes .starling/VERSION
#   - adds the import line to AGENTS.md once, renaming a lone CLAUDE.md to
#     AGENTS.md and creating AGENTS.md if there is none, and adds
#     Antigravity CLI's form of the import to the line of earlier versions
#   - links Starling's skills into .claude/skills/ and .agents/skills/ and
#     removes links to skills Starling no longer has
#   - copies the workflows for the repository's forge, from
#     .starling/workflows/github/ into .github/workflows/ or from
#     .starling/workflows/forgejo/ into .forgejo/workflows/, with the default
#     branch in place of main, and removes Starling workflows that are gone
#     or were installed for the other forge
#   - adds .starling/ to .prettierignore in a project that uses Prettier,
#     and prints the rule that keeps Renovate off Starling's files
#   - creates .claude/settings.json from .starling/claude-settings.json, or
#     merges Starling's entries into it with jq
#   - creates .agents/hooks.json from .starling/agents-hooks.json, or sets
#     its "starling" hook set with jq, for Antigravity CLI
#   - activates Starling's git hooks
# and prints a summary with the commit header to use, and a hint at the
# adopt-starling skill where the project has a setup of its own or an
# update brought new skills. It commits nothing.
#
# STARLING_JQ names the jq to use (tests set it to a missing command).
#
# Exit status: 0 done, 1 failed, 2 usage.

set -u
[ $# -eq 2 ] || {
	echo "usage: integrate SOURCE VERSION" >&2
	exit 2
}
src=$(CDPATH='' cd -- "$1" && pwd -P) && [ -d "$src/.starling" ] || {
	echo "integrate: $1 is not a Starling checkout" >&2
	exit 1
}
version=$2
top=$(git rev-parse --show-toplevel 2>/dev/null) && cd "$top" || {
	echo "integrate: not inside a git work tree" >&2
	exit 1
}

notes=
note() {
	notes="$notes- $*
"
}

old=$(cat .starling/VERSION 2>/dev/null) || old=

# What was here before, for the hint at the adopt-starling skill: the
# skills of the installed Starling, and whether the project has agent
# instructions of its own. Its own skills are found while linking.
old_skills=' '
for skill in .starling/skills/*/; do
	[ -d "$skill" ] && old_skills="$old_skills$(basename "$skill") "
done
own=
[ ! -e AGENTS.md ] && [ ! -e CLAUDE.md ] || own=1
added=

# .starling/: remove, then copy, so that a script still running from the old
# copy keeps reading its old file.
rm -rf .starling && cp -R "$src/.starling" .starling || {
	echo "integrate: cannot copy $src/.starling" >&2
	exit 1
}
printf '%s\n' "$version" >.starling/VERSION

# AGENTS.md and the import line. It imports the file twice: Claude Code
# reads "@path", Antigravity CLI a Markdown link after "@", and each ignores
# the other's form. Claude Code's path must be followed by a space or end
# the line: it does not import "@.starling/AGENTS.md." with a period after it.
link='@[Starling](.starling/AGENTS.md)'
import="This repository also follows the shared rules in Starling; read them before starting any task: @.starling/AGENTS.md $link"
if [ ! -e AGENTS.md ] && [ -f CLAUDE.md ] && [ ! -L CLAUDE.md ]; then
	if git ls-files --error-unmatch CLAUDE.md >/dev/null 2>&1; then
		git mv CLAUDE.md AGENTS.md
	else
		mv CLAUDE.md AGENTS.md
	fi
	note "Renamed CLAUDE.md to AGENTS.md: Claude Code and Codex both read AGENTS.md."
elif [ -f CLAUDE.md ] && [ ! -L CLAUDE.md ]; then
	note "CLAUDE.md exists next to AGENTS.md; the shared rules keep agent instructions in AGENTS.md."
fi
[ -e AGENTS.md ] || printf '# %s\n' "$(basename "$top")" >AGENTS.md
if grep -q '@\.starling/AGENTS\.md @\[Starling\](\.starling/AGENTS\.md)$' AGENTS.md; then
	:
elif grep -q '@\.starling/AGENTS\.md$' AGENTS.md; then
	# The line of an earlier version, which only Claude Code follows.
	awk -v link="$link" '!done && /@\.starling\/AGENTS\.md$/ { $0 = $0 " " link; done = 1 } { print }' \
		AGENTS.md >AGENTS.md.starling && mv AGENTS.md.starling AGENTS.md
	note "Added $link to the import line in AGENTS.md, the form of the import that Antigravity CLI follows."
else
	if grep -q '^# ' AGENTS.md; then
		awk -v line="$import" '
			state == 1 { if ($0 !~ /^[ \t]*$/) print ""; state = 2 }
			state == 0 && /^# / { print; print ""; print line; state = 1; next }
			{ print }
		' AGENTS.md >AGENTS.md.starling
	else
		{ printf '%s\n\n' "$import"; cat AGENTS.md; } >AGENTS.md.starling
	fi
	mv AGENTS.md.starling AGENTS.md
fi

# Skill links. A link Starling made points into ../../.starling/skills/.
for dir in .claude/skills .agents/skills; do
	mkdir -p "$dir"
	for link in "$dir"/*; do
		[ -e "$link" ] || [ -L "$link" ] || continue
		case $(readlink "$link" 2>/dev/null) in
		../../.starling/skills/*) [ -e "$link" ] || rm "$link" ;;
		*) own=1 ;;
		esac
	done
	for skill in .starling/skills/*/; do
		[ -d "$skill" ] || continue
		name=$(basename "$skill")
		link="$dir/$name"
		case "$old_skills$added " in *" $name "*) ;; *) added="$added $name" ;; esac
		if [ ! -e "$link" ] && [ ! -L "$link" ]; then
			ln -s "../../.starling/skills/$name" "$link"
		elif [ ! -L "$link" ] || [ "$(readlink "$link")" != "../../.starling/skills/$name" ]; then
			note "$link belongs to the project, so Starling's $name skill is not linked there. Rename the project's skill: Starling's names are reserved."
		fi
	done
done

# Workflows, for the forge the repository is on and with its default branch
# in place of main. Without a remote the forge is unknown: GitHub's are
# installed, and the next update corrects that.
branch=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) && branch=${branch#origin/} || branch=main
if ! forge=$(.starling/bin/forge kind 2>/dev/null); then
	forge=github
	note "The forge is unknown without an origin remote, so the workflows are GitHub's. On Forgejo, run .starling/bin/update again once the remote exists."
fi
for dir in .github/workflows .forgejo/workflows; do
	for wf in "$dir"/starling-*.yml; do
		[ -e "$wf" ] || continue
		[ "$dir" = ".$forge/workflows" ] && [ -e ".starling/workflows/$forge/$(basename "$wf")" ] || rm "$wf"
	done
done
for wf in .starling/workflows/"$forge"/*.yml; do
	[ -e "$wf" ] || continue
	mkdir -p ".$forge/workflows"
	awk -v branch="$branch" '$0 == "      - main" { print "      - " branch; next } { print }' "$wf" \
		>".$forge/workflows/$(basename "$wf")"
done
[ "$branch" = main ] || note "The workflows run on pushes to $branch, this repository's default branch."

# Prettier. Every update replaces .starling/, so a project that formats its
# tree must leave it alone; Prettier reads .prettierignore.
prettier=
for f in .prettierrc .prettierrc.* prettier.config.* .prettierignore; do
	[ ! -e "$f" ] || prettier=1
done
[ ! -f package.json ] || ! grep -q '"prettier"' package.json || prettier=1
if [ -n "$prettier" ] && ! grep -Eqs '^/?\.starling(/(\*\*)?)?[[:space:]]*$' .prettierignore; then
	if [ -s .prettierignore ]; then
		[ -z "$(tail -c 1 .prettierignore)" ] || echo >>.prettierignore
		echo >>.prettierignore
	fi
	printf '%s\n' "# Starling's files are managed by Starling and replaced on every update." \
		.starling/ >>.prettierignore
fi

# Renovate. Starling bumps the actions it pins, and every update replaces
# .starling/ and the workflows it installs, so Renovate should propose no
# changes there. sh and awk cannot edit JSON5 safely: print the rule.
renovate=
for f in renovate.json renovate.json5 .github/renovate.json .github/renovate.json5 \
	.gitlab/renovate.json .gitlab/renovate.json5 .renovaterc .renovaterc.json .renovaterc.json5; do
	[ -f "$f" ] && renovate=$f && break
done
[ -n "$renovate" ] || [ ! -f package.json ] || ! grep -q '"renovate"[[:space:]]*:' package.json ||
	renovate=package.json
rule="{\"matchFileNames\": [\".starling/**\", \".$forge/workflows/starling-*.yml\"], \"enabled\": false}"
if [ -n "$renovate" ] && ! grep -qF ".$forge/workflows/starling-" "$renovate"; then
	note "Renovate is set up in $renovate. Starling updates the actions it pins and replaces its files on every update, so add this rule to the packageRules there:
  $rule"
fi

# Claude Code settings. Starling owns its attribution keys and every hook
# command under .starling/bin/; the project's other settings stay. Earlier
# versions set attribution.commit and attribution.pr to "", which makes
# Claude Code tell agents to leave out the lines the shared rules ask for,
# so those are removed; any other value is the project's own and stays.
jq=${STARLING_JQ:-jq}
filter='
def starling: (.command? // "") | test("\\.starling/bin/");
.attribution = (((.attribution // {}) + $s[0].attribution)
	| with_entries(select(((.key == "commit" or .key == "pr") and .value == "") | not)))
| .hooks = (
	((.hooks // {}) | with_entries(.value |= [.[] | .hooks |= map(select(starling | not)) | select((.hooks | length) > 0)]))
	| reduce ($s[0].hooks | to_entries[]) as $e (.; .[$e.key] = ((.[$e.key] // []) + $e.value))
	| with_entries(select((.value | length) > 0))
)'
mkdir -p .claude
if [ ! -e .claude/settings.json ]; then
	cp .starling/claude-settings.json .claude/settings.json
elif command -v "$jq" >/dev/null 2>&1 &&
	merged=$("$jq" --slurpfile s .starling/claude-settings.json "$filter" .claude/settings.json); then
	if [ "$merged" != "$(cat .claude/settings.json)" ]; then
		printf '%s\n' "$merged" >.claude/settings.json
		[ -z "$prettier" ] ||
			note "jq rewrote .claude/settings.json to merge Starling's entries. If Prettier formats it, run Prettier on it before committing."
	fi
else
	note "Merge .starling/claude-settings.json into .claude/settings.json by hand (jq is missing or could not read the file): Starling's attribution keys, without an empty attribution.commit or attribution.pr, and its hooks in place of any hook commands under .starling/bin/."
fi

# Antigravity CLI hooks. It runs every named hook set in .agents/hooks.json,
# from .agents/; Starling owns the set named "starling", the project the
# others.
if [ ! -e .agents/hooks.json ]; then
	cp .starling/agents-hooks.json .agents/hooks.json
elif command -v "$jq" >/dev/null 2>&1 &&
	merged=$("$jq" --slurpfile s .starling/agents-hooks.json '.starling = $s[0].starling' .agents/hooks.json); then
	if [ "$merged" != "$(cat .agents/hooks.json)" ]; then
		printf '%s\n' "$merged" >.agents/hooks.json
		[ -z "$prettier" ] ||
			note "jq rewrote .agents/hooks.json to set Starling's hooks. If Prettier formats it, run Prettier on it before committing."
	fi
else
	note "Set the \"starling\" entry of .agents/hooks.json to the one in .starling/agents-hooks.json by hand (jq is missing or could not read the file)."
fi

# Git hooks.
activation=$(.starling/bin/activate-hooks 2>&1)
case $? in
0) ;;
1) note "$(printf '%s\n' "$activation" | sed '2,$s/^/  /')" ;;
*) note "Could not activate Starling's git hooks: $activation" ;;
esac

# Summary.
if [ -z "$old" ]; then
	echo "Installed Starling $version."
	header="build: install Starling $version"
elif [ "$old" = "$version" ]; then
	echo "Reinstalled Starling $version."
	header="build: update Starling to $version"
else
	echo "Updated Starling from $old to $version."
	header="build: update Starling to $version"
fi
changes=$(git status --short -- .starling AGENTS.md CLAUDE.md .claude .agents .github/workflows .forgejo/workflows .prettierignore)
if [ -z "$changes" ]; then
	echo "Nothing changed."
else
	printf '\nChanged:\n%s\n' "$changes"
fi
[ -z "$notes" ] || printf '\nNotes:\n%s' "$notes"
[ -z "$changes" ] || printf '\nReview the changes, then commit them, e.g. with the commit-changes skill:\n  %s\n' "$header"
if [ -z "$old" ]; then
	[ -z "$own" ] || printf '\n%s\n  %s\n' \
		"This repository has agent instructions or skills of its own. The adopt-starling skill compares them with Starling's and proposes what to replace, keep or move into policy files:" \
		".starling/skills/adopt-starling/SKILL.md"
elif [ -n "$added" ]; then
	printf '\nNew skills:%s. The adopt-starling skill checks whether they replace skills of this repository.\n' "$added"
fi
