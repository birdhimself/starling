#!/bin/sh
# Starling: one interface to the forge this repository is on.
#
#   forge kind
#   forge pr view [PR] [--body]
#   forge pr list [--head BRANCH] [--state open|merged|closed] [--search TEXT]
#   forge pr create [--draft] [--base BRANCH] [--head BRANCH] --title TITLE --body-file FILE [--label LABEL]...
#   forge pr edit PR [--title TITLE] [--body-file FILE] [--base BRANCH] [--add-label LABEL]... [--remove-label LABEL]...
#   forge pr ready PR
#   forge pr checks PR [--log-failed]
#   forge pr checkout PR
#   forge pr comments PR
#   forge pr threads PR [--all]
#   forge pr reply PR THREAD --body TEXT
#   forge pr resolve PR THREAD
#   forge runs COMMIT
#   forge issue view ISSUE
#   forge issue list [--label LABEL] [--state open|closed]
#   forge issue create --title TITLE --body-file FILE [--type TYPE] [--label LABEL]...
#   forge issue edit ISSUE [--title TITLE] [--body-file FILE] [--type TYPE] [--add-label LABEL]... [--remove-label LABEL]...
#   forge issue close ISSUE [--duplicate-of ISSUE | --not-planned]
#   forge issue relations ISSUE
#   forge issue block ISSUE --by ISSUE [--remove]
#   forge issue sub ISSUE --of ISSUE [--remove]
#   forge label list
#   forge stack init [--base BRANCH] BRANCH...
#   forge stack add BRANCH
#   forge stack view
#   forge stack checkout BRANCH
#   forge stack bottom | top | up | down
#   forge stack rebase [--upstack | --continue | --abort]
#   forge stack push
#   forge stack submit --auto
#   forge stack sync
#   forge stack merge PR
#   forge api [-X METHOD] [--input FILE] PATH
#
# Skills and scripts call this instead of a forge's own tool, so that they
# name no forge. GitHub is reached through gh, which must be signed in.
# Forgejo is reached through its REST API with curl and jq.
#
# kind         prints github or forgejo: forge.kind in .starling.conf, else
#              github when the origin remote's host is github.com, else
#              forgejo.
# pr view      prints a pull request's facts, one "Key: value" per line:
#              Number, URL, State (open, closed or merged), Draft (yes or
#              no), Title, Head, Head commit, Base, Behind base (yes, no or
#              unknown), then "Commits:" with one "  SHA subject" line each,
#              oldest first. Without PR, the open one of the current branch.
#              --body adds "Body:" and the description, last.
# pr list      prints one "#NUMBER STATE COMMIT URL TITLE" line per pull
#              request, newest first: STATE is draft, ready, merged or
#              closed, COMMIT the head commit. Open ones by default. --search
#              keeps those whose title or description contains TEXT.
# pr create    opens a pull request from the current branch, or --head, onto
#              the default branch, or --base, and prints its URL.
# pr edit      changes the title, the description, the base branch or the
#              labels.
# pr ready     marks a draft as ready for review.
# pr checks    prints one "NAME<TAB>STATE<TAB>URL" line per check on the head
#              commit: STATE is pass, fail, pending or skipped. Exits 1
#              unless every check passed or was skipped, also when there is
#              none. --log-failed prints the logs of the failed ones instead.
# pr checkout  switches to the pull request's head branch, fetching it.
# pr comments  prints the comments on a pull request and the summaries of
#              its reviews, oldest first, each as "AUTHOR, KIND:" and the
#              text, indented.
# pr threads   prints each unresolved review thread as "Thread ID on
#              FILE:LINE", with ", outdated" or ", resolved" where it
#              applies, then every comment as "AUTHOR: text", indented.
#              --all includes the resolved ones.
# pr reply     answers in a review thread, by the ID pr threads printed.
# pr resolve   resolves a review thread, by that ID.
# runs         prints one "ID STATE" line per CI run on COMMIT: STATE is
#              completed or pending.
# issue view   prints an issue's title, state, author, type, labels and
#              number, then its description and every comment.
# issue list   prints one "#NUMBER STATE TITLE" line per issue, open ones by
#              default.
# issue create opens an issue and prints its URL.
# issue edit   changes the title, the description, the type or the labels.
# issue close  closes an issue: as a duplicate of another, as not planned,
#              or as done.
# issue relations
#              prints the issues that block this one, the ones it blocks,
#              its parent and its sub-issues, each as "#NUMBER STATE TITLE"
#              under "Blocked by:", "Blocking:", "Parent:" and "Sub-issues:",
#              or "none".
# issue block  records that the first issue is blocked by the second, or
#              with --remove that it no longer is.
# issue sub    makes the first issue a sub-issue of the second, or with
#              --remove no longer one.
# label list   prints the repository's labels, one per line.
# stack        manages a stack: branches that each build on the one below,
#              with one pull request each whose base is the branch below.
#              init creates the branches, bottom first, adopting those that
#              exist, and switches to the bottom one; add puts a new branch
#              on top. view prints the branches, top first, with their pull
#              requests. checkout, bottom, top, up and down switch between
#              them. rebase puts each branch onto the one below and the
#              bottom one onto the fetched base branch, --upstack only the
#              branches above the current one; after a conflict is resolved,
#              --continue goes on. push pushes every branch with lease.
#              submit --auto pushes and opens a draft pull request for each
#              branch that has none, titled after its first commit. sync
#              fetches, drops branches whose pull request merged, rebases,
#              pushes and sets each pull request's base. merge merges every
#              pull request up to and including PR in one step.
#              On GitHub this is the gh stack extension, which takes more
#              options. On Forgejo the stack is kept in the git directory,
#              and merge fails: there the pull requests merge one at a time.
# api          calls the forge's own API and prints the response. PATH is
#              the forge's, without its /api/v1 prefix on Forgejo; {owner}
#              and {repo} stand for this repository. --input sends a file as
#              the JSON body, - for standard input. The default method is
#              GET, or POST with a body. For what no other subcommand covers.
#
# Forgejo has no issue types and no sub-issues: --type and issue sub fail
# there, saying so, and issue view and issue relations print "not on this
# forge" in their place. Its API cannot resolve a review thread either, so
# pr resolve fails there, saying so.
#
# A draft on Forgejo is a title that starts with "WIP:". The subcommands add
# and remove the prefix, and titles are given and printed without it. When
# the origin remote is a fork, issues and pull requests are its parent's,
# and a pull request is opened from the fork's branch.
#
# On Forgejo, the API is at forge.url in .starling.conf, else at the origin
# remote's host: the remote's own scheme and port for http and https, https
# for ssh. The token is FORGEJO_TOKEN, else the password that git's
# credential helper holds for that host.
#
# Exit status: 0, 1 when the forge cannot be told, cannot be reached or
# refuses, or when checks are not green, 2 usage.

set -u

usage() {
	sed -n '3,/^$/s/^# \{0,1\}//p' "$0" | sed -n '/^  forge /p' | sed '1s/^  /usage: /; 2,$s/^  /       /' >&2
	exit 2
}
die() {
	echo "forge: $*" >&2
	exit 1
}

top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git work tree"

# conf KEY: a value from .starling.conf, or nothing.
conf() {
	[ -f "$top/.starling.conf" ] || return 1
	git config --file "$top/.starling.conf" --get "$1" 2>/dev/null
}

# The origin remote, as "scheme host path": host with its port, path without
# the slashes around it or .git. The scp form user@host:path counts as ssh.
remote=$(git -C "$top" remote get-url origin 2>/dev/null | awk '{
	url = $0
	if (match(url, /^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//)) {
		scheme = substr(url, 1, RLENGTH - 3)
		rest = substr(url, RLENGTH + 1)
		slash = index(rest, "/")
		if (slash == 0) { host = rest; path = "" }
		else { host = substr(rest, 1, slash - 1); path = substr(rest, slash + 1) }
	} else if (match(url, /^[^\/:]+:/)) {
		scheme = "ssh"
		host = substr(url, 1, RLENGTH - 1)
		path = substr(url, RLENGTH + 1)
	} else exit
	sub(/^.*@/, "", host)
	sub(/^\/+/, "", path); sub(/\/+$/, "", path); sub(/\.git$/, "", path)
	print tolower(scheme), tolower(host), path
}')
scheme=${remote%% *}
rest=${remote#* }
host=${rest%% *}
path=${rest#* }

# kind: what .starling.conf says, else what the remote's host says.
find_kind() {
	if kind=$(conf forge.kind); then
		case $kind in
		github | forgejo) ;;
		*)
			echo "forge: forge.kind in .starling.conf must be github or forgejo, not \"$kind\"" >&2
			exit 2
			;;
		esac
	elif [ -z "$remote" ]; then
		die "the origin remote names no host to tell the forge from; set forge.kind in .starling.conf"
	elif [ "${host%:*}" = github.com ]; then
		kind=github
	else
		kind=forgejo
	fi
}

# Forgejo: where the API is, which repository this is, and the token.
forgejo_setup() {
	[ -z "${base:-}" ] || return 0
	for tool in curl jq; do
		command -v "$tool" >/dev/null 2>&1 || die "$tool is needed to reach Forgejo and is not installed"
	done
	[ -n "$remote" ] || die "the origin remote names no host to find the repository at"
	case $path in
	*/*) ;;
	*) die "cannot read an owner and a repository from the origin remote" ;;
	esac
	repo=${path##*/}
	owner=${path%/*}
	prefix=
	case $owner in
	*/*)
		prefix=/${owner%/*}
		owner=${owner##*/}
		;;
	esac
	if base=$(conf forge.url); then
		base=${base%/}
	else
		case $scheme in
		http | https) base=$scheme://$host$prefix ;;
		*) base=https://${host%:*}$prefix ;;
		esac
	fi
	token=${FORGEJO_TOKEN:-}
	if [ -z "$token" ]; then
		origin=${base#*://}
		token=$(printf 'protocol=%s\nhost=%s\n\n' "${base%%://*}" "${origin%%/*}" |
			GIT_TERMINAL_PROMPT=0 git -c core.askPass=true credential fill 2>/dev/null |
			sed -n 's/^password=//p')
	fi
	[ -n "$token" ] ||
		die "no token for $base: set FORGEJO_TOKEN, or store one in git's credential helper for that host"
}

# forgejo_request METHOD PATH [BODY]: print the response, or fail with the
# API's message. PATH is below /api/v1. The token goes to curl on standard
# input, so that it never shows in a process list. http_status holds the
# response's status afterwards, unless this ran in a subshell.
forgejo_request() {
	forgejo_setup
	set -- "$1" "$(printf '%s' "$2" | sed "s|{owner}|$owner|g; s|{repo}|$repo|g; s|^/||")" "${3:-}"
	if [ -n "$3" ]; then
		response=$(printf 'header = "Authorization: token %s"\n' "$token" |
			curl -sS -K - -X "$1" -H 'Accept: application/json' -H 'Content-Type: application/json' \
				--data-binary "$3" -w '\n%{http_code}' "$base/api/v1/$2")
	else
		response=$(printf 'header = "Authorization: token %s"\n' "$token" |
			curl -sS -K - -X "$1" -H 'Accept: application/json' -w '\n%{http_code}' "$base/api/v1/$2")
	fi || die "cannot reach $base"
	http_status=${response##*
}
	response=${response%
*}
	case $http_status in
	2*) [ -z "$response" ] || printf '%s\n' "$response" ;;
	*)
		message=$(printf '%s' "$response" | jq -r '.message // empty' 2>/dev/null) || message=
		echo "forge: $1 $2: HTTP $http_status${message:+: $message}" >&2
		return 1
		;;
	esac
}

# forgejo_target: the repository that issues and pull requests belong to,
# which is the parent when the origin remote is a fork. head_owner is set
# for a fork: a pull request's head is then "owner:branch".
forgejo_target() {
	[ -z "${target:-}" ] || return 0
	forgejo_setup
	about=$(forgejo_request GET "repos/$owner/$repo") || exit 1
	target=$(printf '%s' "$about" | jq -r 'if .fork and .parent then .parent.full_name else .full_name end')
	head_owner=$(printf '%s' "$about" | jq -r 'if .fork and .parent then .owner.login else "" end')
	default_branch=$(printf '%s' "$about" | jq -r 'if .fork and .parent then .parent.default_branch else .default_branch end')
}

# forgejo_pages PATH: every page of a list, as one JSON array. PATH has a
# query already. Stops after 20 pages of 50.
forgejo_pages() {
	page=1
	while [ "$page" -le 20 ]; do
		items=$(forgejo_request GET "$1&limit=50&page=$page") || return 1
		printf '%s\n' "$items"
		[ "$(printf '%s' "$items" | jq length)" -ge 50 ] || break
		page=$((page + 1))
	done | jq -s add
}

# A draft's title on Forgejo starts with one of these, in any case.
wip='^(wip:|\[wip\])\s*'

# number ARG: ARG as a pull request or issue number, with or without #.
number() {
	n=${1#\#}
	case $n in
	'' | *[!0-9]*) usage ;;
	esac
	printf '%s\n' "$n"
}

need_gh() {
	command -v gh >/dev/null 2>&1 || die "gh is needed to reach GitHub and is not installed"
}

# forgejo_current_pr: the number of the open pull request of the current
# branch.
forgejo_current_pr() {
	branch=$(git symbolic-ref -q --short HEAD) || die "no branch is checked out; name the pull request"
	forgejo_target
	found=$(forgejo_pages "repos/$target/pulls?state=open" |
		jq -r --arg b "$branch" 'map(select(.head.ref == $b)) | .[0].number // empty') || exit 1
	[ -n "$found" ] || die "no open pull request for the branch $branch"
	printf '%s\n' "$found"
}

pr_view() {
	pr=
	body=
	for arg in "$@"; do
		case $arg in
		--body) body=1 ;;
		-*) usage ;;
		*)
			[ -z "$pr" ] || usage
			pr=$(number "$arg") || exit 2
			;;
		esac
	done
	if [ "$kind" = github ]; then
		need_gh
		# shellcheck disable=SC2016
		filter='"Number: \(.number)", "URL: \(.url)", "State: \(.state | ascii_downcase)",
			"Draft: \(if .isDraft then "yes" else "no" end)", "Title: \(.title)",
			"Head: \(.headRefName)", "Head commit: \(.headRefOid)", "Base: \(.baseRefName)",
			"Behind base: \(if .mergeStateStatus == "BEHIND" then "yes" elif .mergeStateStatus == "UNKNOWN" then "unknown" else "no" end)",
			"Commits:", (.commits[] | "  \(.oid[0:9]) \(.messageHeadline)")'
		[ -z "$body" ] || filter="$filter, \"Body:\", .body"
		# shellcheck disable=SC2086
		gh pr view $pr --json number,url,state,isDraft,title,headRefName,headRefOid,baseRefName,mergeStateStatus,commits,body \
			--jq "$filter" || exit 1
		return
	fi
	forgejo_target
	[ -n "$pr" ] || pr=$(forgejo_current_pr) || exit 1
	data=$(forgejo_request GET "repos/$target/pulls/$pr") || exit 1
	commits=$(forgejo_pages "repos/$target/pulls/$pr/commits?verification=false&files=false") || exit 1
	printf '%s' "$data" | jq -r --arg wip "$wip" --argjson commits "$commits" --arg body "$body" '
		"Number: \(.number)", "URL: \(.html_url)",
		"State: \(if .merged then "merged" else .state end)",
		"Draft: \(if .draft then "yes" else "no" end)", "Title: \(.title | sub($wip; ""; "i"))",
		"Head: \(.head.ref)", "Head commit: \(.head.sha)", "Base: \(.base.ref)",
		"Behind base: \(if .merged or .state != "open" then "unknown" elif .merge_base == .base.sha then "no" else "yes" end)",
		"Commits:", ($commits | reverse[] | "  \(.sha[0:9]) \(.commit.message | split("\n")[0])"),
		(if $body == "" then empty else "Body:", .body end)'
}

pr_list() {
	head=
	state=open
	search=
	while [ $# -gt 0 ]; do
		case $1 in
		--head | --state | --search)
			[ $# -ge 2 ] || usage
			case $1 in
			--head) head=$2 ;;
			--state) state=$2 ;;
			--search) search=$2 ;;
			esac
			shift
			;;
		*) usage ;;
		esac
		shift
	done
	case $state in
	open | merged | closed) ;;
	*) usage ;;
	esac
	if [ "$kind" = github ]; then
		need_gh
		# shellcheck disable=SC2016
		gh pr list --state "$state" --limit 50 ${head:+--head "$head"} ${search:+--search "$search in:title,body"} \
			--json number,state,isDraft,headRefOid,url,title \
			--jq '.[] | "#\(.number) \(if .state == "MERGED" then "merged" elif .state == "CLOSED" then "closed" elif .isDraft then "draft" else "ready" end) \(.headRefOid) \(.url) \(.title)"' ||
			exit 1
		return
	fi
	forgejo_target
	api_state=closed
	[ "$state" != open ] || api_state=open
	forgejo_pages "repos/$target/pulls?state=$api_state&sort=recentupdate" |
		jq -r --arg wip "$wip" --arg head "$head" --arg state "$state" --arg search "$search" '
		.[]
		| (if .merged then "merged" elif .state == "closed" then "closed" elif .draft then "draft" else "ready" end) as $s
		| select($state == "open" or $s == $state)
		| select($head == "" or .head.ref == $head)
		| select($search == "" or ((.title + "\n" + (.body // "")) | ascii_downcase | contains($search | ascii_downcase)))
		| "#\(.number) \($s) \(.head.sha) \(.html_url) \(.title | sub($wip; ""; "i"))"' || exit 1
}

# pr_fields "$@": read --title, --body-file, --base, --head and --draft into
# variables of those names, and labels into add and remove, one per line;
# anything else goes to rest.
pr_fields() {
	title=
	body_file=
	base_branch=
	head=
	draft=
	add=
	remove=
	rest=
	while [ $# -gt 0 ]; do
		case $1 in
		--title | --body-file | --base | --head | --label | --add-label | --remove-label)
			[ $# -ge 2 ] && [ -n "$2" ] || usage
			case $1 in
			--title) title=$2 ;;
			--body-file) body_file=$2 ;;
			--base) base_branch=$2 ;;
			--head) head=$2 ;;
			--label | --add-label) add="$add$2
" ;;
			--remove-label) remove="$remove$2
" ;;
			esac
			shift
			;;
		--draft) draft=1 ;;
		-*) usage ;;
		*)
			[ -z "$rest" ] || usage
			rest=$1
			;;
		esac
		shift
	done
	[ -z "$body_file" ] || [ -r "$body_file" ] || die "cannot read $body_file"
}

pr_create() {
	pr_fields "$@"
	[ -z "$rest" ] && [ -z "$remove" ] && [ -n "$title" ] && [ -n "$body_file" ] || usage
	if [ "$kind" = github ]; then
		need_gh
		labels=$(commas "$add")
		gh pr create ${draft:+--draft} ${base_branch:+--base "$base_branch"} ${head:+--head "$head"} \
			--title "$title" --body-file "$body_file" ${labels:+--label "$labels"} || exit 1
		return
	fi
	forgejo_target
	[ -n "$head" ] || head=$(git symbolic-ref -q --short HEAD) || die "no branch is checked out; name it with --head"
	[ -z "$draft" ] || title="WIP: $title"
	payload=$(jq -cn --arg title "$title" --rawfile body "$body_file" \
		--arg head "${head_owner:+$head_owner:}$head" --arg base "${base_branch:-$default_branch}" \
		'{title: $title, body: $body, head: $head, base: $base}') || exit 1
	created=$(forgejo_request POST "repos/$target/pulls" "$payload") || exit 1
	# A pull request takes labels as an issue does.
	forgejo_labels "$(printf '%s' "$created" | jq -r .number)"
	printf '%s' "$created" | jq -r .html_url
}

pr_edit() {
	pr_fields "$@"
	[ -n "$rest" ] && [ -z "$draft" ] && [ -z "$head" ] || usage
	pr=$(number "$rest") || exit 2
	[ -n "$title$body_file$base_branch$add$remove" ] || usage
	if [ "$kind" = github ]; then
		need_gh
		labels=$(commas "$add")
		unlabels=$(commas "$remove")
		gh pr edit "$pr" ${title:+--title "$title"} ${body_file:+--body-file "$body_file"} \
			${base_branch:+--base "$base_branch"} ${labels:+--add-label "$labels"} \
			${unlabels:+--remove-label "$unlabels"} >/dev/null || exit 1
		return
	fi
	forgejo_target
	if [ -n "$title" ]; then
		# A draft stays one: keep the prefix its title has.
		prefix=$(forgejo_request GET "repos/$target/pulls/$pr" |
			jq -r --arg wip "$wip" '.title | (capture("(?<p>" + $wip + ")"; "i").p) // ""') || exit 1
		title=$prefix$title
	fi
	payload=$(jq -cn --arg title "$title" --arg base "$base_branch" \
		--rawfile body "${body_file:-/dev/null}" --arg has_body "$body_file" \
		'(if $title != "" then {title: $title} else {} end)
		+ (if $base != "" then {base: $base} else {} end)
		+ (if $has_body != "" then {body: $body} else {} end)') || exit 1
	[ "$payload" = '{}' ] || forgejo_request PATCH "repos/$target/pulls/$pr" "$payload" >/dev/null || exit 1
	forgejo_labels "$pr"
}

pr_ready() {
	[ $# -eq 1 ] || usage
	pr=$(number "$1") || exit 2
	if [ "$kind" = github ]; then
		need_gh
		gh pr ready "$pr" >/dev/null || exit 1
		return
	fi
	forgejo_target
	payload=$(forgejo_request GET "repos/$target/pulls/$pr" |
		jq -c --arg wip "$wip" 'if .draft then {title: (.title | sub($wip; ""; "i"))} else empty end') || exit 1
	[ -z "$payload" ] || forgejo_request PATCH "repos/$target/pulls/$pr" "$payload" >/dev/null || exit 1
}

# pr_head PR: the head commit of a pull request.
pr_head() {
	if [ "$kind" = github ]; then
		gh pr view "$1" --json headRefOid --jq .headRefOid
	else
		forgejo_request GET "repos/$target/pulls/$1" | jq -r .head.sha
	fi
}

pr_checks() {
	pr=
	logs=
	for arg in "$@"; do
		case $arg in
		--log-failed) logs=1 ;;
		-*) usage ;;
		*)
			[ -z "$pr" ] || usage
			pr=$(number "$arg") || exit 2
			;;
		esac
	done
	[ -n "$pr" ] || usage
	if [ "$kind" = github ]; then
		need_gh
		if [ -n "$logs" ]; then
			sha=$(pr_head "$pr") && [ -n "$sha" ] || exit 1
			failed=$(gh run list --commit "$sha" --status failure --limit 50 --json databaseId --jq '.[].databaseId') || exit 1
			[ -n "$failed" ] || die "no failed run on $sha"
			for id in $failed; do
				gh run view "$id" --log-failed || exit 1
			done
			return
		fi
		# gh exits non-zero for failed and for pending checks, with the list
		# printed all the same, so only an empty list is its failure.
		# shellcheck disable=SC2016
		checks=$(gh pr checks "$pr" --json name,bucket,link \
			--jq '.[] | [.name, (if .bucket == "skipping" then "skipped" elif .bucket == "cancel" then "fail" else .bucket end), .link] | @tsv' 2>&1)
		case $checks in
		*'	'*) ;;
		*)
			echo "forge: no checks on #$pr${checks:+: $checks}" >&2
			exit 1
			;;
		esac
	else
		forgejo_target
		sha=$(pr_head "$pr") && [ -n "$sha" ] || exit 1
		statuses=$(forgejo_request GET "repos/$target/commits/$sha/status") || exit 1
		if [ -n "$logs" ]; then
			failed=$(printf '%s' "$statuses" | jq -r '.statuses // [] | .[]
				| select(.status != "success" and .status != "pending" and .status != "skipped")
				| "\(.target_url // "")\t\(.context)"')
			[ -n "$failed" ] || die "no failed check on $sha"
			tab=$(printf '\t')
			printf '%s\n' "$failed" | while IFS=$tab read -r url context; do
				echo "== $context"
				case $url in
				/*/actions/runs/*/jobs/*) forgejo_job_log "$url" || echo "forge: cannot read the log; see $base$url" >&2 ;;
				/*) echo "see $base$url" ;;
				*) echo "see ${url:-the forge}" ;;
				esac
			done
			return
		fi
		checks=$(printf '%s' "$statuses" | jq -r --arg base "$base" '.statuses // [] | .[]
			| [.context,
				(if .status == "success" then "pass" elif .status == "pending" or .status == "skipped" then .status else "fail" end),
				((.target_url // "") | if startswith("/") then $base + . else . end)]
			| @tsv')
		[ -n "$checks" ] || die "no checks on #$pr"
	fi
	printf '%s\n' "$checks"
	! printf '%s\n' "$checks" | awk -F '\t' '$2 != "pass" && $2 != "skipped" { found = 1 } END { exit !found }'
}

# forgejo_job_log PATH: the log of an Actions job, by its path on the web.
# Forgejo's API has no logs, and the web serves each attempt's: print the
# last one that exists.
forgejo_job_log() {
	attempt=1
	log=
	while next=$(printf 'header = "Authorization: token %s"\n' "$token" |
		curl -sS -f -K - "$base$1/attempt/$attempt/logs" 2>/dev/null); do
		log=$next
		attempt=$((attempt + 1))
	done
	[ -n "$log" ] && printf '%s\n' "$log"
}

pr_checkout() {
	[ $# -eq 1 ] || usage
	pr=$(number "$1") || exit 2
	if [ "$kind" = github ]; then
		need_gh
		gh pr checkout "$pr" || exit 1
		return
	fi
	forgejo_target
	branch=$(forgejo_request GET "repos/$target/pulls/$pr" | jq -r .head.ref) && [ -n "$branch" ] || exit 1
	if git fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>/dev/null; then
		git switch -q "$branch" 2>/dev/null || git switch -q -c "$branch" --track "origin/$branch" || exit 1
		git merge -q --ff-only "origin/$branch" || die "$branch has commits that origin/$branch lacks"
	else
		# The head is in another repository: the forge keeps it under pull/.
		git fetch -q origin "pull/$pr/head" && git switch -q -C "$branch" FETCH_HEAD || exit 1
	fi
}

pr_comments() {
	[ $# -eq 1 ] || usage
	pr=$(number "$1") || exit 2
	# shellcheck disable=SC2016
	print='sort_by(.at) | .[] | "\(.author), \(.kind):", (.body | gsub("\r"; "") | gsub("(?m)^"; "  ")), ""'
	if [ "$kind" = github ]; then
		need_gh
		gh pr view "$pr" --json comments,reviews --jq "
			[(.comments[] | {at: .createdAt, author: .author.login, kind: \"comment\", body}),
			(.reviews[] | select(.body != \"\") | {at: .submittedAt, author: .author.login, kind: \"review, \(.state | ascii_downcase)\", body})]
			| $print" || exit 1
		return
	fi
	forgejo_target
	comments=$(forgejo_pages "repos/$target/issues/$pr/comments?") || exit 1
	reviews=$(forgejo_pages "repos/$target/pulls/$pr/reviews?") || exit 1
	jq -rn --argjson comments "$comments" --argjson reviews "$reviews" "
		[(\$comments[] | {at: .created_at, author: .user.login, kind: \"comment\", body}),
		(\$reviews[] | select((.body // \"\") != \"\") | {at: .submitted_at, author: .user.login, kind: \"review, \(.state | ascii_downcase)\", body})]
		| $print"
}

# forgejo_threads PR: the review comments of a pull request as threads, a
# JSON array. Forgejo has no thread object: the comments on one line of one
# file are a conversation, and resolving one marks each of them. A thread's
# id is that of its first comment.
forgejo_threads() {
	reviews=$(forgejo_pages "repos/$target/pulls/$1/reviews?") || return 1
	for review in $(printf '%s' "$reviews" | jq -r '.[] | select(.comments_count > 0) | .id'); do
		forgejo_request GET "repos/$target/pulls/$1/reviews/$review/comments" || return 1
	done | jq -s 'add // [] | group_by([.path, .position, .original_position]) | map(sort_by(.id) | {
		id: .[0].id, path: .[0].path, position: .[0].position, original_position: .[0].original_position,
		line: (if .[0].position > 0 then .[0].position else .[0].original_position end),
		resolved: (map(.resolver != null) | all), outdated: (.[0].position == 0),
		comments: map({author: .user.login, body})}) | sort_by(.id)'
}

pr_threads() {
	pr=
	all=false
	for arg in "$@"; do
		case $arg in
		--all) all=true ;;
		-*) usage ;;
		*)
			[ -z "$pr" ] || usage
			pr=$(number "$arg") || exit 2
			;;
		esac
	done
	[ -n "$pr" ] || usage
	# shellcheck disable=SC2016
	print='[.[] | select($all or (.resolved | not))] |
		if length == 0 then "No \(if $all then "" else "unresolved " end)review threads."
		else map("Thread \(.id) on \(.path):\(.line // "?")" +
			(if .outdated then ", outdated" else "" end) + (if .resolved then ", resolved" else "" end) + "\n" +
			([.comments[] | "  \(.author // "ghost"): \(.body | gsub("\r"; "") | gsub("\n"; "\n    "))"] | join("\n"))
		) | join("\n\n") end'
	if [ "$kind" = github ]; then
		need_gh
		# Review threads exist only in GraphQL; REST cannot tell whether one
		# is resolved.
		# shellcheck disable=SC2016
		query='query($owner: String!, $repo: String!, $pr: Int!) {
		  repository(owner: $owner, name: $repo) {
		    pullRequest(number: $pr) {
		      reviewThreads(first: 100) {
		        totalCount
		        nodes {
		          id isResolved isOutdated path line originalLine
		          comments(first: 50) { nodes { author { login } body } }
		        }
		      }
		    }
		  }
		}'
		gh api graphql -F owner='{owner}' -F repo='{repo}' -F pr="$pr" -f query="$query" --jq "$all as \$all |
			.data.repository.pullRequest.reviewThreads
			| ([.nodes[] | {id, path, line: (.line // .originalLine), resolved: .isResolved, outdated: .isOutdated,
				comments: [.comments.nodes[] | {author: .author.login, body}]}] | $print),
			(if .totalCount > 100 then \"Only the first 100 of \(.totalCount) threads are listed.\" else empty end)" ||
			die "cannot read the review threads of #$pr"
		return
	fi
	forgejo_target
	threads=$(forgejo_threads "$pr") || exit 1
	printf '%s' "$threads" | jq -r --argjson all "$all" "$print"
}

pr_reply() {
	[ $# -eq 4 ] && [ "$3" = --body ] && [ -n "$4" ] || usage
	pr=$(number "$1") || exit 2
	if [ "$kind" = github ]; then
		need_gh
		# shellcheck disable=SC2016
		gh api graphql -F thread="$2" -f body="$4" -f query='
			mutation($thread: ID!, $body: String!) {
			  addPullRequestReviewThreadReply(input: { pullRequestReviewThreadId: $thread, body: $body }) { comment { id } }
			}' >/dev/null || exit 1
		return
	fi
	forgejo_target
	thread=$(number "$2") || exit 2
	# A reply is a review of its own with one comment on the thread's line.
	payload=$(forgejo_threads "$pr" | jq -c --argjson id "$thread" --arg body "$4" '
		.[] | select(.id == $id)
		| {event: "COMMENT", body: "", comments: [{path, body: $body, new_position: .position, old_position: .original_position}]}') ||
		exit 1
	[ -n "$payload" ] || die "#$pr has no review thread $thread"
	forgejo_request POST "repos/$target/pulls/$pr/reviews" "$payload" >/dev/null || exit 1
}

pr_resolve() {
	[ $# -eq 2 ] || usage
	pr=$(number "$1") || exit 2
	[ "$kind" = github ] ||
		die "Forgejo's API cannot resolve a review thread; it stays open until someone resolves it on the web"
	need_gh
	# shellcheck disable=SC2016
	gh api graphql -F thread="$2" -f query='
		mutation($thread: ID!) {
		  resolveReviewThread(input: { threadId: $thread }) { thread { isResolved } }
		}' >/dev/null || exit 1
}

runs() {
	[ $# -eq 1 ] || usage
	if [ "$kind" = github ]; then
		need_gh
		gh run list --commit "$1" --limit 50 --json databaseId,status \
			--jq '.[] | "\(.databaseId) \(if .status == "completed" then "completed" else "pending" end)"' || exit 1
		return
	fi
	# Forgejo knows a commit's CI by its statuses, which other CI systems
	# set too. Each run of a check writes a status with a new id.
	forgejo_target
	forgejo_request GET "repos/$target/commits/$1/status" |
		jq -r '.statuses // [] | .[] | "\(.id) \(if .status == "pending" then "pending" else "completed" end)"' || exit 1
}

# The line both forges print for one issue in a list.
issue_line='"#\(.number) \(.state) \(.title)"'

issue_view() {
	[ $# -eq 1 ] || usage
	issue=$(number "$1") || exit 2
	# shellcheck disable=SC2016
	head_filter='"title:\t\(.title)", "state:\t\(.state)", "author:\t\(.user.login)",
		"type:\t\($type)", "labels:\t\([.labels[].name] | join(", "))", "number:\t\(.number)", "--", (.body // "")'
	comment_filter='.[] | "--", "author:\t\(.user.login)", "created:\t\(.created_at)", "--", (.body // "")'
	if [ "$kind" = github ]; then
		need_gh
		# Without a terminal, gh issue view --comments leaves out the issue
		# itself, and it knows no types, so both parts come from the API.
		gh api "repos/{owner}/{repo}/issues/$issue" --jq "(.type.name // \"none\") as \$type | $head_filter" || exit 1
		gh api --paginate "repos/{owner}/{repo}/issues/$issue/comments?per_page=100" --jq "$comment_filter" || exit 1
		return
	fi
	forgejo_target
	data=$(forgejo_request GET "repos/$target/issues/$issue") || exit 1
	comments=$(forgejo_pages "repos/$target/issues/$issue/comments?sort=oldest") || exit 1
	printf '%s' "$data" | jq -r "\"not on this forge\" as \$type | $head_filter"
	printf '%s' "$comments" | jq -r "$comment_filter"
}

issue_list() {
	label=
	state=open
	while [ $# -gt 0 ]; do
		case $1 in
		--label | --state)
			[ $# -ge 2 ] || usage
			case $1 in
			--label) label=$2 ;;
			--state) state=$2 ;;
			esac
			shift
			;;
		*) usage ;;
		esac
		shift
	done
	case $state in
	open | closed) ;;
	*) usage ;;
	esac
	if [ "$kind" = github ]; then
		need_gh
		gh issue list --state "$state" --limit 100 ${label:+--label "$label"} --json number,state,title \
			--jq '.[] | "#\(.number) \(.state | ascii_downcase) \(.title)"' || exit 1
		return
	fi
	forgejo_target
	forgejo_pages "repos/$target/issues?type=issues&state=$state&labels=$(printf '%s' "$label" | jq -sRr @uri)" |
		jq -r ".[] | $issue_line" || exit 1
}

# issue_fields "$@": read the options of issue create and issue edit into
# title, body_file, type, add and remove (labels, one per line); anything
# else goes to rest.
issue_fields() {
	title=
	body_file=
	type=
	add=
	remove=
	rest=
	while [ $# -gt 0 ]; do
		case $1 in
		--title | --body-file | --type | --label | --add-label | --remove-label)
			[ $# -ge 2 ] && [ -n "$2" ] || usage
			case $1 in
			--title) title=$2 ;;
			--body-file) body_file=$2 ;;
			--type) type=$2 ;;
			--label | --add-label) add="$add$2
" ;;
			--remove-label) remove="$remove$2
" ;;
			esac
			shift
			;;
		-*) usage ;;
		*)
			[ -z "$rest" ] || usage
			rest=$1
			;;
		esac
		shift
	done
	[ -z "$body_file" ] || [ -r "$body_file" ] || die "cannot read $body_file"
	[ -z "$type" ] || [ "$kind" = github ] ||
		die "Forgejo has no issue types; leave out --type, and use what the repository's policy names in its place"
}

# commas LINES: labels, one per line, as gh takes them.
commas() {
	printf '%s' "$1" | awk 'NF { printf "%s%s", sep, $0; sep = "," }'
}

# forgejo_labels ISSUE: add and remove the labels in add and remove.
forgejo_labels() {
	if [ -n "$add" ]; then
		payload=$(printf '%s' "$add" | jq -cRn '{labels: [inputs | select(. != "")]}')
		forgejo_request POST "repos/$target/issues/$1/labels" "$payload" >/dev/null || exit 1
	fi
	printf '%s' "$remove" | while IFS= read -r name; do
		[ -n "$name" ] || continue
		forgejo_request DELETE "repos/$target/issues/$1/labels/$(printf '%s' "$name" | jq -sRr @uri)" >/dev/null || exit 1
	done || exit 1
}

issue_create() {
	issue_fields "$@"
	[ -z "$rest" ] && [ -z "$remove" ] && [ -n "$title" ] && [ -n "$body_file" ] || usage
	if [ "$kind" = github ]; then
		need_gh
		labels=$(commas "$add")
		gh issue create --title "$title" --body-file "$body_file" ${type:+--type "$type"} ${labels:+--label "$labels"} || exit 1
		return
	fi
	forgejo_target
	payload=$(jq -cn --arg title "$title" --rawfile body "$body_file" '{title: $title, body: $body}') || exit 1
	created=$(forgejo_request POST "repos/$target/issues" "$payload") || exit 1
	# Creating takes label ids, adding takes names.
	forgejo_labels "$(printf '%s' "$created" | jq -r .number)"
	printf '%s' "$created" | jq -r .html_url
}

issue_edit() {
	issue_fields "$@"
	[ -n "$rest" ] || usage
	issue=$(number "$rest") || exit 2
	[ -n "$title$body_file$type$add$remove" ] || usage
	if [ "$kind" = github ]; then
		need_gh
		labels=$(commas "$add")
		unlabels=$(commas "$remove")
		gh issue edit "$issue" ${title:+--title "$title"} ${body_file:+--body-file "$body_file"} ${type:+--type "$type"} \
			${labels:+--add-label "$labels"} ${unlabels:+--remove-label "$unlabels"} >/dev/null || exit 1
		return
	fi
	forgejo_target
	if [ -n "$title$body_file" ]; then
		payload=$(jq -cn --arg title "$title" --rawfile body "${body_file:-/dev/null}" --arg has_body "$body_file" \
			'(if $title != "" then {title: $title} else {} end) + (if $has_body != "" then {body: $body} else {} end)') || exit 1
		forgejo_request PATCH "repos/$target/issues/$issue" "$payload" >/dev/null || exit 1
	fi
	forgejo_labels "$issue"
}

issue_close() {
	[ $# -ge 1 ] || usage
	issue=$(number "$1") || exit 2
	shift
	duplicate=
	reason=
	case ${1:-} in
	'') ;;
	--duplicate-of)
		[ $# -eq 2 ] || usage
		duplicate=$(number "$2") || exit 2
		;;
	--not-planned)
		[ $# -eq 1 ] || usage
		reason="not planned"
		;;
	*) usage ;;
	esac
	if [ "$kind" = github ]; then
		need_gh
		gh issue close "$issue" ${duplicate:+--duplicate-of "$duplicate"} ${reason:+--reason "$reason"} >/dev/null || exit 1
		return
	fi
	# Forgejo closes without a reason, so a duplicate is named in a comment.
	forgejo_target
	if [ -n "$duplicate" ]; then
		forgejo_request POST "repos/$target/issues/$issue/comments" "{\"body\":\"Duplicate of #$duplicate.\"}" >/dev/null || exit 1
	fi
	forgejo_request PATCH "repos/$target/issues/$issue" '{"state":"closed"}' >/dev/null || exit 1
}

# related LABEL LINES: one list of related issues, under its label.
related() {
	echo "$1:"
	if [ -n "$2" ]; then
		printf '%s\n' "$2" | sed 's/^/  /'
	else
		echo "  none"
	fi
}

issue_relations() {
	[ $# -eq 1 ] || usage
	issue=$(number "$1") || exit 2
	if [ "$kind" = github ]; then
		need_gh
		for list in "Blocked by:dependencies/blocked_by" "Blocking:dependencies/blocking"; do
			lines=$(gh api "repos/{owner}/{repo}/issues/$issue/${list#*:}?per_page=100" --jq ".[] | $issue_line") ||
				die "cannot read \"${list%%:*}\" for #$issue"
			related "${list%%:*}" "$lines"
		done
		# GitHub answers 404 for an issue without a parent.
		if parent=$(gh api "repos/{owner}/{repo}/issues/$issue/parent" --jq "$issue_line" 2>&1); then
			related Parent "$parent"
		else
			case $parent in
			*404* | *"Not Found"*) related Parent "" ;;
			*) die "cannot read the parent of #$issue: $parent" ;;
			esac
		fi
		lines=$(gh api "repos/{owner}/{repo}/issues/$issue/sub_issues?per_page=100" --jq ".[] | $issue_line") ||
			die "cannot read \"Sub-issues\" for #$issue"
		related Sub-issues "$lines"
		return
	fi
	forgejo_target
	for list in "Blocked by:dependencies" "Blocking:blocks"; do
		lines=$(forgejo_pages "repos/$target/issues/$issue/${list#*:}?") || exit 1
		related "${list%%:*}" "$(printf '%s' "$lines" | jq -r ".[] | $issue_line")"
	done
	related Parent "not on this forge"
	related Sub-issues "not on this forge"
}

# issue_pair "$@": read "ISSUE OPTION ISSUE [--remove]" into issue, other
# and undo, where OPTION is the first argument.
issue_pair() {
	option=$1
	shift
	[ $# -ge 3 ] && [ "$2" = "$option" ] || usage
	issue=$(number "$1") || exit 2
	other=$(number "$3") || exit 2
	undo=
	case ${4:-} in
	'') ;;
	--remove) undo=1 ;;
	*) usage ;;
	esac
	[ $# -le 4 ] || usage
}

issue_block() {
	issue_pair --by "$@"
	if [ "$kind" = github ]; then
		need_gh
		# GitHub links issues by their id, not their number.
		id=$(gh api "repos/{owner}/{repo}/issues/$other" --jq .id) || exit 1
		if [ -n "$undo" ]; then
			gh api -X DELETE "repos/{owner}/{repo}/issues/$issue/dependencies/blocked_by/$id" >/dev/null || exit 1
		else
			gh api -X POST "repos/{owner}/{repo}/issues/$issue/dependencies/blocked_by" -F issue_id="$id" >/dev/null || exit 1
		fi
		return
	fi
	forgejo_target
	payload="{\"owner\":\"${target%/*}\",\"repo\":\"${target#*/}\",\"index\":$other}"
	method=POST
	[ -z "$undo" ] || method=DELETE
	forgejo_request "$method" "repos/$target/issues/$issue/dependencies" "$payload" >/dev/null || exit 1
}

issue_sub() {
	issue_pair --of "$@"
	[ "$kind" = github ] ||
		die "Forgejo has no sub-issues; record the hierarchy the way the repository's policy says, else in the parent's description"
	need_gh
	id=$(gh api "repos/{owner}/{repo}/issues/$issue" --jq .id) || exit 1
	if [ -n "$undo" ]; then
		gh api -X DELETE "repos/{owner}/{repo}/issues/$other/sub_issue" -F sub_issue_id="$id" >/dev/null || exit 1
	else
		gh api -X POST "repos/{owner}/{repo}/issues/$other/sub_issues" -F sub_issue_id="$id" >/dev/null || exit 1
	fi
}

label_list() {
	[ $# -eq 0 ] || usage
	if [ "$kind" = github ]; then
		need_gh
		gh label list --limit 200 --json name --jq '.[].name' || exit 1
		return
	fi
	forgejo_target
	forgejo_pages "repos/$target/labels?" | jq -r '.[].name' || exit 1
	# An organization's labels apply to its repositories too.
	forgejo_request GET "orgs/${target%/*}/labels?limit=50" 2>/dev/null | jq -r '.[].name'
	return 0
}

# A stack on Forgejo, which has no stacks of its own. The state is a file
# in the git directory, so each worktree has its own: a "base NAME" line,
# then one "branch NAME COMMIT" line per branch, bottom first, where COMMIT
# is the tip the branch below had when this branch was last put onto it.
# Rebasing replays only what follows that commit, so an amended lower branch
# does not bring its old commits along.
stack_file() {
	printf '%s/starling-stack\n' "$(git rev-parse --absolute-git-dir)"
}

stack_read() {
	file=$(stack_file)
	[ -f "$file" ] || die "no stack in this work tree; create one with: forge stack init BRANCH..."
	stack_base=$(sed -n 's/^base //p' "$file")
	stack_branches=$(sed -n 's/^branch \([^ ]*\) .*/\1/p' "$file")
}

# stack_record BRANCH COMMIT: set the commit recorded for a branch.
stack_record() {
	file=$(stack_file)
	state=$(awk -v b="$1" -v c="$2" '$1 == "branch" && $2 == b { $3 = c } { print }' "$file") &&
		printf '%s\n' "$state" >"$file"
}

# stack_neighbor BRANCH OFFSET: the branch OFFSET places above BRANCH.
stack_neighbor() {
	printf '%s\n' "$stack_branches" | awk -v b="$1" -v o="$2" '
		{ name[NR] = $0; if ($0 == b) at = NR }
		END { if (at && (at + o) in name) print name[at + o] }'
}

stack_init() {
	stack_base=
	if [ "${1:-}" = --base ]; then
		[ $# -ge 2 ] || usage
		stack_base=$2
		shift 2
	fi
	[ $# -ge 1 ] || usage
	if [ -z "$stack_base" ]; then
		stack_base=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) || stack_base=origin/main
		stack_base=${stack_base#origin/}
	fi
	git rev-parse -q --verify "origin/$stack_base^{commit}" >/dev/null || die "there is no origin/$stack_base to base the stack on"
	state="base $stack_base"
	below=origin/$stack_base
	for branch in "$@"; do
		git rev-parse -q --verify "refs/heads/$branch" >/dev/null ||
			git branch --no-track "$branch" "$below" || exit 1
		state="$state
branch $branch $(git merge-base "$branch" "$below")" || die "$branch and $below share no history"
		below=$branch
	done
	printf '%s\n' "$state" >"$(stack_file)"
	git switch -q "$1" || exit 1
	echo "Stack on $stack_base, bottom first: $*. Now on $1."
}

stack_add() {
	[ $# -eq 1 ] || usage
	stack_read
	top=$(printf '%s\n' "$stack_branches" | tail -n 1)
	git switch -q -c "$1" --no-track "$top" || exit 1
	printf 'branch %s %s\n' "$1" "$(git rev-parse "$top")" >>"$(stack_file)"
}

stack_view() {
	stack_read
	forgejo_target
	current=$(git symbolic-ref -q --short HEAD) || current=
	open=$(pr_list) || exit 1
	printf '%s\n' "$stack_branches" | awk '{ line[NR] = $0 } END { for (i = NR; i >= 1; i--) print line[i] }' |
		while IFS= read -r branch; do
			mark=' '
			[ "$branch" != "$current" ] || mark='*'
			sha=$(git rev-parse -q --verify "refs/heads/$branch") || sha=
			pr=$(printf '%s\n' "$open" | awk -v s="$sha" '$3 == s { print $1, $2, $4; exit }')
			[ -n "$pr" ] || pr=$(pr_list --head "$branch" | awk 'NR == 1 { print $1, $2, $4 }')
			echo "$mark $branch  ${pr:-no pull request}"
		done
	echo "  $stack_base"
}

stack_checkout() {
	stack_read
	current=$(git symbolic-ref -q --short HEAD) || current=
	case $1 in
	bottom) to=$(printf '%s\n' "$stack_branches" | head -n 1) ;;
	top) to=$(printf '%s\n' "$stack_branches" | tail -n 1) ;;
	up) to=$(stack_neighbor "$current" 1) ;;
	down) to=$(stack_neighbor "$current" -1) ;;
	*) to=$(stack_neighbor "$1" 0) ;;
	esac
	[ -n "$to" ] || die "the stack has no such branch; forge stack view lists them"
	git switch -q "$to" || exit 1
}

stack_rebase() {
	mode=${1:-}
	[ $# -le 1 ] || usage
	stack_read
	case $mode in
	'' | --upstack) ;;
	--continue) GIT_EDITOR=true git rebase --continue || die "the rebase still has conflicts; resolve them, git add, then: forge stack rebase --continue" ;;
	--abort)
		git rebase --abort
		return
		;;
	*) usage ;;
	esac
	origin=$(git symbolic-ref -q --short HEAD) || origin=
	[ -n "$mode" ] || git fetch -q origin || exit 1
	below=origin/$stack_base
	skip=
	[ "$mode" != --upstack ] || skip=$origin
	for branch in $stack_branches; do
		if [ -n "$skip" ]; then
			[ "$branch" != "$skip" ] || skip=
			below=$branch
			continue
		fi
		if ! git merge-base --is-ancestor "$below" "$branch"; then
			from=$(sed -n "s/^branch $(printf '%s' "$branch" | sed 's/[.[\*^$/]/\\&/g') //p" "$(stack_file)")
			git merge-base --is-ancestor "$from" "$branch" 2>/dev/null || from=$below
			git rebase -q --onto "$below" "$from" "$branch" ||
				die "rebasing $branch onto $below stopped on a conflict; resolve it, git add, then: forge stack rebase --continue"
		fi
		stack_record "$branch" "$(git rev-parse "$below")"
		below=$branch
	done
	[ -z "$origin" ] || git switch -q "$origin"
}

stack_push() {
	stack_read
	# shellcheck disable=SC2086
	git push -q --force-with-lease -u origin $stack_branches || exit 1
}

# stack_bases: push, then give each branch's pull request the branch below
# as its base, opening a draft where CREATE is set and there is none.
stack_bases() {
	create=$1
	forgejo_target
	[ -z "$head_owner" ] ||
		die "a stack needs its branches in the repository the pull requests go to, and the origin remote is a fork"
	stack_push
	below=$stack_base
	for branch in $stack_branches; do
		pr=$(pr_list --head "$branch" | sed -n '1s/^#\([0-9]*\) .*/\1/p')
		if [ -n "$pr" ]; then
			base_now=$(forgejo_request GET "repos/$target/pulls/$pr" | jq -r .base.ref) || exit 1
			[ "$base_now" = "$below" ] ||
				forgejo_request PATCH "repos/$target/pulls/$pr" "{\"base\":\"$below\"}" >/dev/null || exit 1
		elif [ -n "$create" ]; then
			first=$(git rev-list --reverse "$below..$branch" | head -n 1)
			[ -n "$first" ] || die "$branch has no commits of its own yet"
			payload=$(jq -cn --arg title "WIP: $(git log -1 --format=%s "$first")" --arg body "$(git log -1 --format=%b "$first")" \
				--arg head "$branch" --arg base "$below" '{title: $title, body: $body, head: $head, base: $base}')
			forgejo_request POST "repos/$target/pulls" "$payload" | jq -r '"#\(.number) \(.html_url)"' || exit 1
		fi
		below=$branch
	done
}

stack_sync() {
	[ $# -eq 0 ] || usage
	stack_read
	forgejo_target
	git fetch -q origin || exit 1
	# A merged pull request's branch leaves the stack; the one above keeps
	# its recorded commit, so it is replayed onto the base without it.
	for branch in $stack_branches; do
		[ -n "$(pr_list --state merged --head "$branch")" ] || break
		file=$(stack_file)
		state=$(awk -v b="$branch" '!($1 == "branch" && $2 == b)' "$file") && printf '%s\n' "$state" >"$file"
		echo "$branch merged and left the stack."
	done
	stack_read
	[ -n "$stack_branches" ] || {
		rm -f "$(stack_file)"
		echo "Every branch merged; the stack is gone."
		return
	}
	stack_rebase
	stack_bases ""
	stack_view
}

stack() {
	[ $# -ge 1 ] || usage
	if [ "$kind" = github ]; then
		need_gh
		gh stack --help >/dev/null 2>&1 || die "the gh stack extension is needed for stacks on GitHub and is not installed"
		exec gh stack "$@"
	fi
	sub=$1
	shift
	case $sub in
	init) stack_init "$@" ;;
	add) stack_add "$@" ;;
	view) stack_view ;;
	checkout)
		[ $# -eq 1 ] || usage
		stack_checkout "$1"
		;;
	bottom | top | up | down)
		[ $# -eq 0 ] || usage
		stack_checkout "$sub"
		;;
	rebase) stack_rebase "$@" ;;
	push)
		[ $# -eq 0 ] || usage
		stack_push
		;;
	submit)
		[ "${1:-}" = --auto ] && [ $# -eq 1 ] || usage
		stack_read
		stack_bases create
		;;
	sync) stack_sync "$@" ;;
	merge)
		die "Forgejo merges a stack one pull request at a time: merge the bottom one there, run forge stack sync, and go on with the next"
		;;
	*) usage ;;
	esac
}

[ $# -ge 1 ] || usage
command=$1
shift

case $command in
kind)
	[ $# -eq 0 ] || usage
	find_kind
	echo "$kind"
	;;
pr)
	[ $# -ge 1 ] || usage
	sub=$1
	shift
	find_kind
	case $sub in
	view) pr_view "$@" ;;
	list) pr_list "$@" ;;
	create) pr_create "$@" ;;
	edit) pr_edit "$@" ;;
	ready) pr_ready "$@" ;;
	checks) pr_checks "$@" ;;
	checkout) pr_checkout "$@" ;;
	comments) pr_comments "$@" ;;
	threads) pr_threads "$@" ;;
	reply) pr_reply "$@" ;;
	resolve) pr_resolve "$@" ;;
	*) usage ;;
	esac
	;;
runs)
	find_kind
	runs "$@"
	;;
issue)
	[ $# -ge 1 ] || usage
	sub=$1
	shift
	find_kind
	case $sub in
	view) issue_view "$@" ;;
	list) issue_list "$@" ;;
	create) issue_create "$@" ;;
	edit) issue_edit "$@" ;;
	close) issue_close "$@" ;;
	relations) issue_relations "$@" ;;
	block) issue_block "$@" ;;
	sub) issue_sub "$@" ;;
	*) usage ;;
	esac
	;;
stack)
	find_kind
	stack "$@"
	;;
label)
	[ "${1:-}" = list ] || usage
	shift
	find_kind
	label_list "$@"
	;;
api)
	method=
	input=
	api_path=
	while [ $# -gt 0 ]; do
		case $1 in
		-X)
			[ $# -ge 2 ] || usage
			method=$2
			shift
			;;
		--input)
			[ $# -ge 2 ] || usage
			input=$2
			shift
			;;
		-*) usage ;;
		*)
			[ -z "$api_path" ] || usage
			api_path=$1
			;;
		esac
		shift
	done
	[ -n "$api_path" ] || usage
	find_kind
	if [ "$kind" = github ]; then
		need_gh
		exec gh api ${method:+-X "$method"} ${input:+--input "$input"} "$api_path"
	fi
	body=
	if [ -n "$input" ]; then
		body=$(cat -- "$input") || die "cannot read $input"
		[ -n "$body" ] || die "$input is empty"
	fi
	[ -n "$method" ] || method=${body:+POST}
	# {owner} and {repo} are the repository issues and pull requests are in.
	case $api_path in
	*'{owner}'* | *'{repo}'*)
		forgejo_target
		owner=${target%/*}
		repo=${target#*/}
		;;
	esac
	forgejo_request "${method:-GET}" "$api_path" "$body" || exit 1
	;;
*) usage ;;
esac
