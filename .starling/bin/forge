#!/bin/sh
# Starling: one interface to the forge this repository is on.
#
#   forge kind
#   forge api [-X METHOD] [--input FILE] PATH
#
# Skills and scripts call this instead of a forge's own tool, so that they
# name no forge. GitHub is reached through gh, which must be signed in.
# Forgejo is reached through its REST API with curl and jq.
#
# kind   prints github or forgejo: forge.kind in .starling.conf, else
#        github when the origin remote's host is github.com, else forgejo.
# api    calls the forge's own API and prints the response. PATH is the
#        forge's, without its /api/v1 prefix on Forgejo; {owner} and {repo}
#        stand for this repository. --input sends a file as the JSON body,
#        - for standard input. The default method is GET, or POST with a
#        body. For what no other subcommand covers.
#
# On Forgejo, the API is at forge.url in .starling.conf, else at the origin
# remote's host: the remote's own scheme and port for http and https, https
# for ssh. The token is FORGEJO_TOKEN, else the password that git's
# credential helper holds for that host.
#
# Exit status: 0, 1 when the forge cannot be told, cannot be reached or
# refuses, 2 usage.

set -u

usage() {
	echo "usage: forge kind | api [-X METHOD] [--input FILE] PATH" >&2
	exit 2
}
die() {
	echo "forge: $*" >&2
	exit 1
}

top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git work tree"

# conf KEY: a value from .starling.conf, or nothing.
conf() {
	[ -f "$top/.starling.conf" ] || return 1
	git config --file "$top/.starling.conf" --get "$1" 2>/dev/null
}

# The origin remote, as "scheme host path": host with its port, path without
# the slashes around it or .git. The scp form user@host:path counts as ssh.
remote=$(git -C "$top" remote get-url origin 2>/dev/null | awk '{
	url = $0
	if (match(url, /^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//)) {
		scheme = substr(url, 1, RLENGTH - 3)
		rest = substr(url, RLENGTH + 1)
		slash = index(rest, "/")
		if (slash == 0) { host = rest; path = "" }
		else { host = substr(rest, 1, slash - 1); path = substr(rest, slash + 1) }
	} else if (match(url, /^[^\/:]+:/)) {
		scheme = "ssh"
		host = substr(url, 1, RLENGTH - 1)
		path = substr(url, RLENGTH + 1)
	} else exit
	sub(/^.*@/, "", host)
	sub(/^\/+/, "", path); sub(/\/+$/, "", path); sub(/\.git$/, "", path)
	print tolower(scheme), tolower(host), path
}')
scheme=${remote%% *}
rest=${remote#* }
host=${rest%% *}
path=${rest#* }

# kind: what .starling.conf says, else what the remote's host says.
find_kind() {
	if kind=$(conf forge.kind); then
		case $kind in
		github | forgejo) ;;
		*)
			echo "forge: forge.kind in .starling.conf must be github or forgejo, not \"$kind\"" >&2
			exit 2
			;;
		esac
	elif [ -z "$remote" ]; then
		die "there is no origin remote to tell the forge from; add it, or set forge.kind in .starling.conf"
	elif [ "${host%:*}" = github.com ]; then
		kind=github
	else
		kind=forgejo
	fi
}

# Forgejo: where the API is, which repository this is, and the token.
forgejo_setup() {
	[ -z "${base:-}" ] || return 0
	for tool in curl jq; do
		command -v "$tool" >/dev/null 2>&1 || die "$tool is needed to reach Forgejo and is not installed"
	done
	[ -n "$remote" ] || die "there is no origin remote to find the repository from"
	case $path in
	*/*) ;;
	*) die "cannot read an owner and a repository from the origin remote" ;;
	esac
	repo=${path##*/}
	owner=${path%/*}
	prefix=
	case $owner in
	*/*)
		prefix=/${owner%/*}
		owner=${owner##*/}
		;;
	esac
	if base=$(conf forge.url); then
		base=${base%/}
	else
		case $scheme in
		http | https) base=$scheme://$host$prefix ;;
		*) base=https://${host%:*}$prefix ;;
		esac
	fi
	token=${FORGEJO_TOKEN:-}
	if [ -z "$token" ]; then
		origin=${base#*://}
		token=$(printf 'protocol=%s\nhost=%s\n\n' "${base%%://*}" "${origin%%/*}" |
			GIT_TERMINAL_PROMPT=0 git -c core.askPass=true credential fill 2>/dev/null |
			sed -n 's/^password=//p')
	fi
	[ -n "$token" ] ||
		die "no token for $base: set FORGEJO_TOKEN, or store one in git's credential helper for that host"
}

# forgejo_request METHOD PATH [BODY]: print the response, or fail with the
# API's message. PATH is below /api/v1. The token goes to curl on standard
# input, so that it never shows in a process list. http_status holds the
# response's status afterwards, unless this ran in a subshell.
forgejo_request() {
	forgejo_setup
	set -- "$1" "$(printf '%s' "$2" | sed "s|{owner}|$owner|g; s|{repo}|$repo|g; s|^/||")" "${3:-}"
	if [ -n "$3" ]; then
		response=$(printf 'header = "Authorization: token %s"\n' "$token" |
			curl -sS -K - -X "$1" -H 'Accept: application/json' -H 'Content-Type: application/json' \
				--data-binary "$3" -w '\n%{http_code}' "$base/api/v1/$2")
	else
		response=$(printf 'header = "Authorization: token %s"\n' "$token" |
			curl -sS -K - -X "$1" -H 'Accept: application/json' -w '\n%{http_code}' "$base/api/v1/$2")
	fi || die "cannot reach $base"
	http_status=${response##*
}
	response=${response%
*}
	case $http_status in
	2*) [ -z "$response" ] || printf '%s\n' "$response" ;;
	*)
		message=$(printf '%s' "$response" | jq -r '.message // empty' 2>/dev/null) || message=
		echo "forge: $1 $2: HTTP $http_status${message:+: $message}" >&2
		return 1
		;;
	esac
}

[ $# -ge 1 ] || usage
command=$1
shift

case $command in
kind)
	[ $# -eq 0 ] || usage
	find_kind
	echo "$kind"
	;;
api)
	method=
	input=
	target=
	while [ $# -gt 0 ]; do
		case $1 in
		-X)
			[ $# -ge 2 ] || usage
			method=$2
			shift
			;;
		--input)
			[ $# -ge 2 ] || usage
			input=$2
			shift
			;;
		-*) usage ;;
		*)
			[ -z "$target" ] || usage
			target=$1
			;;
		esac
		shift
	done
	[ -n "$target" ] || usage
	find_kind
	if [ "$kind" = github ]; then
		command -v gh >/dev/null 2>&1 || die "gh is needed to reach GitHub and is not installed"
		exec gh api ${method:+-X "$method"} ${input:+--input "$input"} "$target"
	fi
	body=
	if [ -n "$input" ]; then
		body=$(cat -- "$input") || die "cannot read $input"
		[ -n "$body" ] || die "$input is empty"
	fi
	[ -n "$method" ] || method=${body:+POST}
	forgejo_request "${method:-GET}" "$target" "$body" || exit 1
	;;
*) usage ;;
esac
